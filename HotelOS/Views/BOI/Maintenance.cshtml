@model List<HotelOS.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Bakım Yönetimi";
    Layout = null;

    var employees = ViewBag.MaintenanceEmployees as List<HotelOS.Models.Employee>
        ?? new List<HotelOS.Models.Employee>();

    string PriorityClass(string? priority) => priority switch
    {
        "Çok Acil" => "cok-acil",
        "Acil" => "acil",
        "Yüksek" => "yuksek",
        "Düşük" => "dusuk",
        _ => "normal"
    };
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>HotelOS - Bakım Yönetimi</title>

    <link rel="stylesheet" href="~/css/boi.css" />
    <link rel="stylesheet" href="~/css/maintenance.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f5f7fb;
            color: #172033;
        }

        .maintenance-page {
            width: 100%;
            min-height: 100vh;
            padding: 32px 42px;
        }

        .maintenance-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 30px;
        }

        .page-heading {
            min-width: 0;
        }

        .breadcrumb {
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 13px;
        }

        .page-heading h1 {
            margin: 0;
            color: #172033;
            font-size: 30px;
            font-weight: 700;
            line-height: 1.2;
        }

        .page-heading p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .dashboard-btn,
        .new-request-btn {
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 17px;
            border-radius: 9px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: .2s ease;
        }

        .dashboard-btn {
            background: white;
            border: 1px solid #dbe3ec;
            color: #334155;
        }

            .dashboard-btn:hover {
                background: #f8fafc;
                border-color: #cbd5e1;
                color: #2563eb;
            }

        .new-request-btn {
            border: 1px solid #4f46e5;
            background: #4f46e5;
            color: white;
            cursor: pointer;
        }

            .new-request-btn:hover {
                background: #4338ca;
                border-color: #4338ca;
            }

        .message-success,
        .message-error {
            width: 100%;
            padding: 14px 17px;
            margin-bottom: 18px;
            border-radius: 10px;
            font-size: 13px;
        }

        .message-success {
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #bbf7d0;
            border-left: 4px solid #10b981;
        }

        .message-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
            border-left: 4px solid #ef4444;
        }

        .panel {
            width: 100%;
            padding: 25px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .025);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

            .panel-header h2 {
                margin: 0 0 5px;
                color: #172033;
                font-size: 19px;
                font-weight: 700;
            }

            .panel-header p {
                margin: 0;
                color: #94a3b8;
                font-size: 13px;
            }

        .tasks-count {
            padding: 7px 13px;
            background: #fff7ed;
            color: #c2410c;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .maintenance-list {
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

        .maint-item {
            display: grid;
            grid-template-columns: 48px minmax(250px, 1fr) auto minmax(500px, auto);
            align-items: center;
            gap: 18px;
            width: 100%;
            padding: 17px 18px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: white;
            transition: .2s ease;
        }

            .maint-item:hover {
                border-color: #dbe3ec;
                box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
            }

        .maintenance-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #fff7ed;
            font-size: 22px;
        }

        .maint-info {
            min-width: 0;
        }

            .maint-info strong {
                display: block;
                color: #111827;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.4;
            }

            .maint-info span {
                display: block;
                margin-top: 5px;
                color: #6b7280;
                font-size: 12px;
                line-height: 1.5;
                word-break: break-word;
            }

        .priority-tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 72px;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

            .priority-tag.cok-acil {
                background: #fee2e2;
                color: #b91c1c;
            }

            .priority-tag.acil {
                background: #ffedd5;
                color: #c2410c;
            }

            .priority-tag.yuksek {
                background: #fef3c7;
                color: #a16207;
            }

            .priority-tag.dusuk {
                background: #ecfdf5;
                color: #15803d;
            }

            .priority-tag.normal {
                background: #f1f5f9;
                color: #475569;
            }

        .maint-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 7px;
        }

        .action-form {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .employee-select,
        .action-btn {
            height: 38px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
        }

        .employee-select {
            min-width: 190px;
            padding: 0 10px;
            border: 1px solid #dbe3ec;
            background: white;
            color: #374151;
            outline: none;
        }

            .employee-select:focus {
                border-color: #6366f1;
            }

        .action-btn {
            padding: 0 12px;
            border: 1px solid #dbe3ec;
            background: white;
            color: #475569;
            cursor: pointer;
            transition: .2s ease;
            white-space: nowrap;
        }

            .action-btn:hover {
                background: #f8fafc;
                border-color: #cbd5e1;
            }

            .action-btn.complete {
                color: #16a34a;
                border-color: #bbf7d0;
            }

                .action-btn.complete:hover {
                    background: #f0fdf4;
                }

            .action-btn.cancel {
                color: #b91c1c;
                border-color: #fecaca;
            }

                .action-btn.cancel:hover {
                    background: #fef2f2;
                }

            .action-btn.detail {
                color: #2563eb;
                border-color: #bfdbfe;
            }

                .action-btn.detail:hover {
                    background: #eff6ff;
                }

        .empty-tasks {
            padding: 65px 20px;
            text-align: center;
            border: 1px dashed #d5dde8;
            border-radius: 11px;
        }

        .empty-symbol {
            margin-bottom: 15px;
            font-size: 45px;
        }

        .empty-tasks strong {
            display: block;
            margin-bottom: 7px;
            color: #374151;
            font-size: 16px;
        }

        .empty-tasks span {
            color: #9ca3af;
            font-size: 13px;
        }

        .detail-modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, .48);
        }

        .detail-modal {
            width: min(650px, 100%);
            max-height: 85vh;
            overflow-y: auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .18);
        }

        .detail-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 20px 23px;
            border-bottom: 1px solid #edf0f4;
        }

            .detail-modal-header h3 {
                margin: 0;
                color: #172033;
                font-size: 18px;
            }

        .detail-modal-close {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 8px;
            background: #f2f4f7;
            color: #667085;
            cursor: pointer;
            font-size: 15px;
        }

            .detail-modal-close:hover {
                background: #e8ebef;
            }

        .detail-modal-body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            padding: 22px 23px;
        }

        .detail-row {
            padding: 13px;
            border: 1px solid #edf0f4;
            border-radius: 9px;
            background: #fafbfc;
        }

            .detail-row span {
                display: block;
                margin-bottom: 5px;
                color: #98a2b3;
                font-size: 11px;
                font-weight: 600;
            }

            .detail-row strong {
                display: block;
                color: #334155;
                font-size: 13px;
            }

        .detail-row-full {
            grid-column: 1 / -1;
        }

            .detail-row-full p {
                margin: 0;
                color: #475569;
                font-size: 13px;
                line-height: 1.6;
            }

        @@media (max-width: 1400px) {
            .maint-item {
                grid-template-columns: 48px minmax(220px, 1fr) auto;
            }

            .maint-actions {
                grid-column: 2 / -1;
                justify-content: flex-start;
            }
        }

        @@media (max-width: 900px) {
            .maintenance-page {
                padding: 25px;
            }

            .maintenance-topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .topbar-actions {
                width: 100%;
                justify-content: flex-end;
            }

            .maint-item {
                grid-template-columns: 48px 1fr;
            }

            .priority-tag {
                grid-column: 2;
                justify-self: start;
            }

            .maint-actions {
                grid-column: 2;
                width: 100%;
            }
        }

        @@media (max-width: 650px) {
            .maintenance-page {
                padding: 20px;
            }

            .topbar-actions {
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .panel {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .maint-item {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .priority-tag,
            .maint-actions {
                grid-column: auto;
            }

            .maint-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .action-form {
                width: 100%;
            }

            .employee-select {
                flex: 1;
                min-width: 0;
            }

            .action-btn {
                width: 100%;
            }

            .detail-modal-body {
                grid-template-columns: 1fr;
            }

            .detail-row-full {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>
    <main class="maintenance-page">

        <header class="maintenance-topbar">

            <div class="page-heading">

                <div class="breadcrumb">
                    HotelOS / BOİ / Bakım
                </div>

                <h1>Bakım Yönetimi</h1>

                <p>
                    Açık bakım taleplerini görüntüleyin ve personele atayın.
                </p>

            </div>

            <div class="topbar-actions">

                <a href="/BOI" class="dashboard-btn">
                    ← Dashboard'a Dön
                </a>

                <button class="new-request-btn"
                        type="button"
                        onclick="location.href='/MaintenanceRequestCreate'">
                    + Yeni Talep
                </button>

            </div>

        </header>

        @if (TempData["Success"] != null)
        {
            <div class="message-success">
                ✓ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message-error">
                ⚠ @TempData["Error"]
            </div>
        }

        <section class="panel">

            <div class="panel-header">

                <div>
                    <h2>Açık Bakım Talepleri</h2>

                    <p>
                        @Model.Count aktif talep
                    </p>
                </div>

                <div class="tasks-count">
                    @Model.Count Aktif Talep
                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="empty-tasks">

                    <div class="empty-symbol">
                        ✓
                    </div>

                    <strong>
                        Açık bakım talebi yok
                    </strong>

                    <span>
                        Tüm talepler tamamlanmış durumda.
                    </span>

                </div>
            }
            else
            {
                <div class="maintenance-list">

                    @foreach (var req in Model)
                    {
                        <div class="maint-item">

                            <div class="maintenance-icon">
                                🔧
                            </div>

                            <div class="maint-info">

                                <strong>
                                    Oda @(req.Room?.RoomNumber ?? "-") — @(req.Title ?? "Başlıksız talep")
                                </strong>

                                <span>
                                    @(string.IsNullOrWhiteSpace(req.Description)
                                                                ? "Açıklama yok"
                                                                : req.Description)
                                                                                  · @req.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                                                              </span>

                            </div>

                            <span class="priority-tag @PriorityClass(req.Priority)">
                                @(req.Priority ?? "Normal")
                            </span>

                            <div class="maint-actions">

                                <form action="/MaintenancePanel/Assign"
                                      method="post"
                                      class="action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@req.Id" />

                                    <select name="employeeId"
                                            class="employee-select">

                                        <option value="">
                                            @(req.Employee != null
                                                                                ? $"{req.Employee.FirstName} {req.Employee.LastName}"
                                                                                : "Personel seç")
                                </option>

                                @foreach (var emp in employees)
                                        {
                                            <option value="@emp.Id"
                                                    selected="@(req.EmployeeId == emp.Id)">
                                                @emp.FirstName @emp.LastName
                                            </option>
                                        }

                                    </select>

                                    <button type="submit"
                                            class="action-btn">
                                        Ata
                                    </button>

                                </form>

                                <form action="/MaintenancePanel/Escalate"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@req.Id" />

                                    <button type="submit"
                                            class="action-btn"
                                            title="Önceliği yükselt">
                                        ⬆ Yükselt
                                    </button>

                                </form>

                                <form action="/MaintenancePanel/Complete"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@req.Id" />

                                    <button type="submit"
                                            class="action-btn complete">
                                        ✓ Tamamla
                                    </button>

                                </form>

                                <form action="/MaintenancePanel/Cancel"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@req.Id" />

                                    <button type="submit"
                                            class="action-btn cancel">
                                        ✕ İptal
                                    </button>

                                </form>

                                <button type="button"
                                        class="action-btn detail"
                                        onclick="openDetailModal(this)"
                                        data-room="@(req.Room?.RoomNumber ?? "-")"
                                        data-title="@(req.Title ?? "Başlıksız talep")"
                                        data-description="@(req.Description ?? "Açıklama yok")"
                                        data-priority="@(req.Priority ?? "Normal")"
                                        data-status="@(req.Status ?? "-")"
                                        data-employee="@(req.Employee != null ? $"{req.Employee.FirstName} {req.Employee.LastName}" : "Atanmadı")"
                                        data-created="@req.CreatedAt.ToString("dd.MM.yyyy HH:mm")">
                                    Detay
                                </button>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    </main>

    <div id="detailModalOverlay"
         class="detail-modal-overlay"
         style="display:none;"
         onclick="if(event.target===this) closeDetailModal()">

        <div class="detail-modal">

            <div class="detail-modal-header">

                <h3 id="dmTitle">
                    -
                </h3>

                <button type="button"
                        class="detail-modal-close"
                        onclick="closeDetailModal()">
                    ✕
                </button>

            </div>

            <div class="detail-modal-body">

                <div class="detail-row">
                    <span>Oda</span>
                    <strong id="dmRoom">-</strong>
                </div>

                <div class="detail-row">
                    <span>Durum</span>
                    <strong id="dmStatus">-</strong>
                </div>

                <div class="detail-row">
                    <span>Öncelik</span>
                    <strong id="dmPriority">-</strong>
                </div>

                <div class="detail-row">
                    <span>Atanan Personel</span>
                    <strong id="dmEmployee">-</strong>
                </div>

                <div class="detail-row">
                    <span>Oluşturulma</span>
                    <strong id="dmCreated">-</strong>
                </div>

                <div class="detail-row detail-row-full">
                    <span>Açıklama</span>
                    <p id="dmDescription">-</p>
                </div>

            </div>

        </div>

    </div>

    <script>
        function openDetailModal(btn) {
            document.getElementById("dmTitle").textContent = btn.dataset.title;
            document.getElementById("dmRoom").textContent = "Oda " + btn.dataset.room;
            document.getElementById("dmStatus").textContent = btn.dataset.status;
            document.getElementById("dmPriority").textContent = btn.dataset.priority;
            document.getElementById("dmEmployee").textContent = btn.dataset.employee;
            document.getElementById("dmCreated").textContent = btn.dataset.created;
            document.getElementById("dmDescription").textContent = btn.dataset.description;
            document.getElementById("detailModalOverlay").style.display = "flex";
        }

        function closeDetailModal() {
            document.getElementById("detailModalOverlay").style.display = "none";
        }

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeDetailModal();
            }
        });
    </script>

</body>
</html>