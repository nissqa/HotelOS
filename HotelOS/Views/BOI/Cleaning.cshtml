@model List<HotelOS.Models.CleaningTask>

@{
    ViewData["Title"] = "Temizlik Yönetimi";

    var employees = ViewBag.CleaningEmployees as List<HotelOS.Models.Employee>
        ?? new List<HotelOS.Models.Employee>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>HotelOS - Temizlik Yönetimi</title>

    <link rel="stylesheet" href="~/css/boi.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f5f7fb;
            color: #172033;
        }

        .cleaning-page {
            min-height: 100vh;
            width: 100%;
            padding: 32px 42px;
        }

        .cleaning-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 30px;
        }

        .page-heading {
            min-width: 0;
        }

        .breadcrumb {
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 13px;
        }

        .page-heading h1 {
            margin: 0;
            color: #172033;
            font-size: 30px;
            font-weight: 700;
            line-height: 1.2;
        }

        .page-heading p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-shrink: 0;
        }

        .dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 42px;
            padding: 0 17px;
            background: #ffffff;
            border: 1px solid #dbe3ec;
            border-radius: 9px;
            color: #334155;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: .2s ease;
        }

            .dashboard-btn:hover {
                background: #f8fafc;
                border-color: #cbd5e1;
                color: #2563eb;
            }

        .notification-btn {
            position: relative;
            width: 42px;
            height: 42px;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            background: white;
            cursor: pointer;
            font-size: 17px;
        }

            .notification-btn:hover {
                background: #f8fafc;
            }

        .top-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .top-avatar {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #2563eb;
            color: white;
            font-size: 14px;
            font-weight: 700;
        }

        .top-user strong {
            display: block;
            color: #172033;
            font-size: 13px;
        }

        .top-user small {
            display: block;
            margin-top: 3px;
            color: #94a3b8;
            font-size: 11px;
        }

        .message-success {
            padding: 14px 17px;
            margin-bottom: 18px;
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            font-size: 13px;
        }

        .message-error {
            padding: 14px 17px;
            margin-bottom: 18px;
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
            border-radius: 10px;
            font-size: 13px;
        }

        .panel {
            width: 100%;
            padding: 25px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .025);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

            .panel-header h2 {
                margin: 0 0 5px;
                color: #172033;
                font-size: 19px;
                font-weight: 700;
            }

            .panel-header p {
                margin: 0;
                color: #94a3b8;
                font-size: 13px;
            }

        .task-count {
            flex-shrink: 0;
            padding: 7px 13px;
            background: #eef2ff;
            color: #4338ca;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .tasks-container {
            width: 100%;
        }

        .cleaning-task {
            display: grid;
            grid-template-columns: 52px minmax(220px, 1fr) 180px auto;
            align-items: center;
            gap: 20px;
            width: 100%;
            padding: 17px 18px;
            margin-bottom: 11px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            transition: .2s ease;
        }

            .cleaning-task:last-child {
                margin-bottom: 0;
            }

            .cleaning-task:hover {
                border-color: #dbe3ec;
                box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
            }

        .room-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #ecfdf5;
            font-size: 23px;
        }

        .task-info {
            min-width: 0;
        }

            .task-info strong {
                display: block;
                margin-bottom: 5px;
                color: #111827;
                font-size: 15px;
                font-weight: 700;
            }

            .task-info span {
                display: block;
                margin-top: 3px;
                color: #6b7280;
                font-size: 12px;
            }

        .task-status {
            min-width: 0;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 11px;
            border-radius: 20px;
            background: #fff7ed;
            color: #c2410c;
            font-size: 12px;
            font-weight: 600;
        }

        .assigned-person {
            display: block;
            margin-top: 6px;
            color: #6b7280;
            font-size: 12px;
        }

        .assign-form {
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: flex-end;
        }

        .employee-select {
            width: 190px;
            height: 40px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 0 10px;
            background: white;
            color: #374151;
            outline: none;
            font-size: 13px;
        }

            .employee-select:focus {
                border-color: #6366f1;
            }

        .assign-btn {
            height: 40px;
            padding: 0 18px;
            border: none;
            border-radius: 8px;
            background: #4f46e5;
            color: white;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
        }

            .assign-btn:hover {
                background: #4338ca;
            }

        .empty-tasks {
            padding: 65px 20px;
            text-align: center;
            border: 1px dashed #d5dde8;
            border-radius: 11px;
        }

        .empty-symbol {
            margin-bottom: 15px;
            font-size: 45px;
        }

        .empty-tasks strong {
            display: block;
            margin-bottom: 7px;
            color: #374151;
            font-size: 16px;
        }

        .empty-tasks span {
            color: #9ca3af;
            font-size: 13px;
        }

        @@media (max-width: 1100px) {
            .cleaning-page {
                padding: 25px;
            }

            .cleaning-task {
                grid-template-columns: 52px 1fr;
            }

            .task-status {
                grid-column: 2;
            }

            .assign-form {
                grid-column: 2;
                justify-content: flex-start;
            }
        }

        @@media (max-width: 700px) {
            .cleaning-page {
                padding: 20px;
            }

            .cleaning-topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .topbar-actions {
                width: 100%;
                justify-content: flex-end;
                flex-wrap: wrap;
            }

            .panel {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .cleaning-task {
                grid-template-columns: 1fr;
                gap: 13px;
            }

            .task-status,
            .assign-form {
                grid-column: auto;
                width: 100%;
            }

            .assign-form {
                justify-content: stretch;
            }

            .employee-select {
                flex: 1;
                width: auto;
            }

            .assign-btn {
                flex-shrink: 0;
            }
        }
    </style>
</head>

<body>
    <main class="cleaning-page">

        <header class="cleaning-topbar">

            <div class="page-heading">
                <div class="breadcrumb">
                    HotelOS / BOİ / Temizlik
                </div>

                <h1>Temizlik Yönetimi</h1>

                <p>
                    Temizlik gerektiren odaları ve personel atamalarını yönetin.
                </p>
            </div>

            <div class="topbar-actions">

                <a href="/BOI" class="dashboard-btn">
                    ← Dashboard'a Dön
                </a>

                <button class="notification-btn" type="button">
                    🔔
                </button>

                <div class="top-user">

                    <div class="top-avatar">
                        B
                    </div>

                    <div>
                        <strong>BOİ Müdürü</strong>
                        <small>Operasyon Müdürü</small>
                    </div>

                </div>

            </div>

        </header>

        <div class="cleaning-content">

            @if (TempData["Success"] != null)
            {
                <div class="message-success">
                    ✓ @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="message-error">
                    ⚠ @TempData["Error"]
                </div>
            }

            <section class="panel">

                <div class="panel-header">

                    <div>
                        <h2>Temizlik Görevleri</h2>

                        <p>
                            Temizlik bekleyen odalara personel atayın.
                        </p>
                    </div>

                    <div class="task-count">
                        @(Model?.Count ?? 0) Bekleyen Görev
                    </div>

                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="empty-tasks">

                        <div class="empty-symbol">
                            🧹
                        </div>

                        <strong>
                            Bekleyen temizlik görevi yok
                        </strong>

                        <span>
                            Yeni bir temizlik görevi oluşturulduğunda burada görünecek.
                        </span>

                    </div>
                }
                else
                {
                    <div class="tasks-container">

                        @foreach (var task in Model)
                        {
                            <div class="cleaning-task">

                                <div class="room-icon">
                                    🛏️
                                </div>

                                <div class="task-info">

                                    <strong>
                                        Oda @task.Room?.RoomNumber
                                    </strong>

                                    <span>
                                        Görev tarihi:
                                        @task.TaskDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(task.Notes))
                                    {
                                        <span>
                                            Not: @task.Notes
                                        </span>
                                    }

                                </div>

                                <div class="task-status">

                                    <span class="status-badge">
                                        @task.Status
                                    </span>

                                    @if (task.Employee != null)
                                    {
                                        <span class="assigned-person">
                                            👤 @task.Employee.FirstName @task.Employee.LastName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="assigned-person">
                                            Personel atanmadı
                                        </span>
                                    }

                                </div>

                                <form method="post"
                                      action="/BOI/AssignCleaning"
                                      class="assign-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="taskId"
                                           value="@task.Id" />

                                    <select name="employeeId"
                                            class="employee-select"
                                            required>

                                        <option value="">
                                            Personel seç
                                        </option>

                                        @foreach (var employee in employees)
                                        {
                                            <option value="@employee.Id">
                                                @employee.FirstName @employee.LastName
                                            </option>
                                        }

                                    </select>

                                    <button type="submit"
                                            class="assign-btn">
                                        Ata
                                    </button>

                                </form>

                            </div>
                        }

                    </div>
                }

            </section>

        </div>

    </main>
</body>
</html>