@model List<HotelOS.Models.Customer>

@{
    ViewData["Title"] = "Müşteriler";
}

<div class="customers-page">

    <div class="page-header">

        <div>
            <h1>👥 Müşteriler</h1>
            <p>Otel müşterilerini ve konaklama geçmişlerini yönetin.</p>
        </div>

        <button type="button"
                class="add-btn"
                onclick="openCustomerModal()">
            ＋ Yeni Müşteri
        </button>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            ✅ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">
            ❌ @TempData["ErrorMessage"]
        </div>
    }

    <div class="stats">

        <div class="stat-card stat-total active-filter"
             data-filter="all"
             onclick="filterCustomers('all', this)">

            <div class="stat-icon">
                👥
            </div>

            <div>
                <span>Toplam Müşteri</span>
                <strong>@ViewBag.TotalCustomers</strong>
            </div>

        </div>

        <div class="stat-card stat-active"
             data-filter="active"
             onclick="filterCustomers('active', this)">

            <div class="stat-icon green-icon">
                🟢
            </div>

            <div>
                <span>Aktif Konaklayan</span>
                <strong>@ViewBag.ActiveCustomers</strong>
            </div>

        </div>

        <div class="stat-card stat-past"
             data-filter="past"
             onclick="filterCustomers('past', this)">

            <div class="stat-icon gray-icon">
                📋
            </div>

            <div>
                <span>Geçmiş Müşteri</span>
                <strong>@ViewBag.PastCustomers</strong>
            </div>

        </div>

    </div>

    <div class="filter-info">
        <div>
            <strong id="filterTitle">Tüm Müşteriler</strong>
            <span id="filterDescription">
                Sistemde kayıtlı tüm müşteriler gösteriliyor.
            </span>
        </div>

        <button type="button"
                id="clearFilterBtn"
                onclick="filterCustomers('all')"
                style="display:none;">
            ✕ Filtreyi Temizle
        </button>
    </div>

    <div class="table-card">

        <div class="table-top">

            <div>
                <h2>Müşteri Listesi</h2>
                <p id="listDescription">Kayıtlı müşteriler</p>
            </div>

            <div class="search-box">
                🔍

                <input type="text"
                       id="customerSearch"
                       placeholder="Ad, soyad, telefon veya e-posta ara..." />

            </div>

        </div>

        <div class="table-container">

            <table id="customerTable">

                <thead>

                    <tr>
                        <th>Müşteri</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Son Oda</th>
                        <th>Giriş</th>
                        <th>Çıkış</th>
                        <th>Durum</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var customer in Model)
                        {
                            var lastReservation = customer.Reservations
                            .OrderByDescending(r => r.CheckIn)
                            .FirstOrDefault();

                            var isActive =
                            lastReservation != null &&
                            lastReservation.CheckIn <= DateTime.Now &&
                            lastReservation.CheckOut > DateTime.Now;

                            var customerStatus = isActive ? "active" : "past";

                            <tr class="customer-row"
                                data-customer-status="@customerStatus">

                                <td>

                                    <div class="customer-info">

                                        <div class="avatar">

                                            @(string.IsNullOrEmpty(customer.FirstName)
                                                                                ? "?"
                                                                                : customer.FirstName.Substring(0, 1))

                                            @(string.IsNullOrEmpty(customer.LastName)
                                                                                ? "?"
                                                                                : customer.LastName.Substring(0, 1))

                                </div>

                                        <div>

                                            <strong>
                                                @customer.FirstName @customer.LastName
                                            </strong>

                                            <small>
                                                #@customer.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @(customer.Phone ?? "-")
                                </td>

                                <td>
                                    @(customer.Email ?? "-")
                                </td>

                                <td>
                                    @(lastReservation?.Room?.RoomNumber ?? "-")
                                </td>

                                <td>
                                    @(lastReservation?.CheckIn.ToString("dd.MM.yyyy") ?? "-")
                                </td>

                                <td>
                                    @(lastReservation?.CheckOut.ToString("dd.MM.yyyy") ?? "-")
                                </td>

                                <td>

                            @if (isActive)
                                    {
                                        <span class="status active">
                                            ● Konaklıyor
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status passive">
                                            ● Ayrıldı
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="empty">

                                👥 Henüz kayıtlı müşteri bulunmuyor.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<div id="customerModal" class="modal">

    <div class="modal-content">

        <div class="modal-header">

            <div>
                <h2>➕ Yeni Müşteri</h2>

                <p>
                    Yeni müşteri bilgilerini girin.
                </p>
            </div>

            <button type="button"
                    class="close-btn"
                    onclick="closeCustomerModal()">
                ✕
            </button>

        </div>

        <form action="/CustomerPanel/Create" method="post">

            <div class="form-grid">

                <div class="form-group">

                    <label>Ad *</label>

                    <input type="text"
                           name="FirstName"
                           required
                           placeholder="Müşteri adı" />

                </div>

                <div class="form-group">

                    <label>Soyad *</label>

                    <input type="text"
                           name="LastName"
                           required
                           placeholder="Müşteri soyadı" />

                </div>

                <div class="form-group">

                    <label>E-posta</label>

                    <input type="email"
                           name="Email"
                           placeholder="ornek@mail.com" />

                </div>

                <div class="form-group">

                    <label>Telefon</label>

                    <input type="text"
                           name="Phone"
                           placeholder="0555 555 55 55" />

                </div>

                <div class="form-group">

                    <label>Kimlik No</label>

                    <input type="text"
                           name="IdentityNumber"
                           maxlength="11"
                           placeholder="T.C. Kimlik No" />

                </div>

                <div class="form-group">

                    <label>Doğum Tarihi</label>

                    <input type="date"
                           name="BirthDate" />

                </div>

                <div class="form-group">

                    <label>Uyruk</label>

                    <input type="text"
                           name="Nationality"
                           value="Türkiye" />

                </div>

                <div class="form-group full">

                    <label>Adres</label>

                    <textarea name="Address"
                              rows="3"
                              placeholder="Adres"></textarea>

                </div>

            </div>

            <div class="modal-actions">

                <button type="button"
                        class="cancel-btn"
                        onclick="closeCustomerModal()">
                    Vazgeç
                </button>

                <button type="submit"
                        class="save-btn">
                    ✓ Müşteriyi Kaydet
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f6f7fb;
        font-family: "Segoe UI", sans-serif;
        color: #1f2937;
    }

    .customers-page {
        padding: 30px;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
        }

        .page-header p {
            margin-top: 7px;
            color: #6b7280;
        }

    .add-btn {
        border: none;
        background: #4f46e5;
        color: white;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 14px;
        cursor: pointer;
        font-weight: 600;
        transition: .2s;
        white-space: nowrap;
    }

        .add-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

    .success-message {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
        padding: 13px 17px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .error-message {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        padding: 13px 17px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
        cursor: pointer;
        border: 2px solid transparent;
        transition: all .2s ease;
        user-select: none;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0,0,0,.09);
        }

        .stat-card.active-filter {
            border-color: #6366f1;
            box-shadow: 0 6px 20px rgba(99,102,241,.15);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .green-icon {
        background: #dcfce7;
    }

    .gray-icon {
        background: #f3f4f6;
    }

    .stat-card span {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .stat-card strong {
        font-size: 24px;
    }

    .filter-info {
        background: white;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border: 1px solid #e5e7eb;
    }

        .filter-info strong {
            display: block;
            font-size: 14px;
            margin-bottom: 3px;
        }

        .filter-info span {
            color: #6b7280;
            font-size: 12px;
        }

    #clearFilterBtn {
        border: none;
        background: #f3f4f6;
        color: #374151;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 12px;
    }

        #clearFilterBtn:hover {
            background: #e5e7eb;
        }

    .table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .table-top {
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eee;
    }

        .table-top h2 {
            margin: 0;
        }

        .table-top p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    .search-box {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 9px 13px;
        width: 320px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .search-box input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
        }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        font-size: 12px;
        color: #6b7280;
        padding: 15px 18px;
        background: #fafafa;
    }

    td {
        padding: 15px 18px;
        border-top: 1px solid #f1f1f1;
        font-size: 14px;
    }

    tbody tr {
        transition: .15s;
    }

        tbody tr:hover {
            background: #fafafa;
        }

    .customer-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #e0e7ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #4338ca;
        flex-shrink: 0;
    }

    .customer-info small {
        display: block;
        color: #9ca3af;
        margin-top: 3px;
    }

    .status {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .status.active {
            background: #dcfce7;
            color: #15803d;
        }

        .status.passive {
            background: #f3f4f6;
            color: #6b7280;
        }

    .empty {
        text-align: center;
        padding: 40px;
        color: #6b7280;
    }

    .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal.show {
            display: flex;
        }

    .modal-content {
        width: min(700px,100%);
        max-height: 90vh;
        overflow-y: auto;
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 25px;
    }

        .modal-header h2 {
            margin: 0;
        }

        .modal-header p {
            margin: 6px 0 0;
            color: #6b7280;
        }

    .close-btn {
        border: none;
        background: #f3f4f6;
        width: 35px;
        height: 35px;
        border-radius: 9px;
        cursor: pointer;
        font-size: 16px;
    }

        .close-btn:hover {
            background: #e5e7eb;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 17px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

        .form-group input,
        .form-group textarea {
            border: 1px solid #d1d5db;
            border-radius: 9px;
            padding: 11px 12px;
            outline: none;
            font-family: inherit;
            font-size: 14px;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                border-color: #6366f1;
            }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .cancel-btn {
        border: none;
        background: #f3f4f6;
        color: #374151;
        padding: 11px 18px;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 600;
    }

        .cancel-btn:hover {
            background: #e5e7eb;
        }

    .save-btn {
        border: none;
        background: #4f46e5;
        color: white;
        padding: 11px 18px;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 600;
    }

        .save-btn:hover {
            background: #4338ca;
        }

    @@media (max-width: 900px) {

        .stats {
            grid-template-columns: 1fr;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-btn {
            width: 100%;
        }

        .table-top {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }
    }

    @@media (max-width: 600px) {

        .customers-page {
            padding: 20px;
        }

        .filter-info {
            align-items: flex-start;
            flex-direction: column;
        }

        #clearFilterBtn {
            width: 100%;
        }
    }

</style>

<script>

    let currentFilter = "all";

    function filterCustomers(filter, clickedCard) {

        currentFilter = filter;

        document.querySelectorAll(".stat-card").forEach(function (card) {
            card.classList.remove("active-filter");
        });

        if (clickedCard) {
            clickedCard.classList.add("active-filter");
        }
        else {
            const targetCard =
                document.querySelector(
                    '.stat-card[data-filter="' + filter + '"]'
                );

            if (targetCard) {
                targetCard.classList.add("active-filter");
            }
        }

        const rows =
            document.querySelectorAll(".customer-row");

        const searchInput =
            document.getElementById("customerSearch");

        const search =
            searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";

        rows.forEach(function (row) {

            const status =
                row.getAttribute("data-customer-status");

            const text =
                row.innerText.toLowerCase();

            const matchesFilter =
                filter === "all" ||
                status === filter;

            const matchesSearch =
                text.includes(search);

            row.style.display =
                matchesFilter && matchesSearch
                    ? ""
                    : "none";

        });

        const filterTitle =
            document.getElementById("filterTitle");

        const filterDescription =
            document.getElementById("filterDescription");

        const listDescription =
            document.getElementById("listDescription");

        const clearButton =
            document.getElementById("clearFilterBtn");

        if (filter === "active") {

            filterTitle.textContent = "🟢 Aktif Konaklayanlar";
            filterDescription.textContent =
                "Şu anda otelde konaklayan müşteriler gösteriliyor.";
            listDescription.textContent =
                "Şu anda otelde konaklayan müşteriler";

            clearButton.style.display = "block";

        }
        else if (filter === "past") {

            filterTitle.textContent = "📋 Geçmiş Müşteriler";
            filterDescription.textContent =
                "Konaklaması sona ermiş müşteriler gösteriliyor.";
            listDescription.textContent =
                "Konaklaması sona ermiş müşteriler";

            clearButton.style.display = "block";

        }
        else {

            filterTitle.textContent = "👥 Tüm Müşteriler";
            filterDescription.textContent =
                "Sistemde kayıtlı tüm müşteriler gösteriliyor.";
            listDescription.textContent =
                "Kayıtlı müşteriler";

            clearButton.style.display = "none";
        }
    }

    const searchInput =
        document.getElementById("customerSearch");

    if (searchInput) {

        searchInput.addEventListener("keyup", function () {

            const search =
                this.value.toLowerCase().trim();

            document
                .querySelectorAll(".customer-row")
                .forEach(function (row) {

                    const status =
                        row.getAttribute("data-customer-status");

                    const text =
                        row.innerText.toLowerCase();

                    const matchesFilter =
                        currentFilter === "all" ||
                        status === currentFilter;

                    const matchesSearch =
                        text.includes(search);

                    row.style.display =
                        matchesFilter && matchesSearch
                            ? ""
                            : "none";

                });

        });

    }

    function openCustomerModal() {

        document
            .getElementById("customerModal")
            .classList.add("show");

    }

    function closeCustomerModal() {

        document
            .getElementById("customerModal")
            .classList.remove("show");

    }

    window.addEventListener("click", function (event) {

        const modal =
            document.getElementById("customerModal");

        if (event.target === modal) {
            closeCustomerModal();
        }

    }
    );

</script>