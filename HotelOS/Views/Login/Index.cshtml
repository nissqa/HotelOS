```cshtml
@{
    ViewData["Title"] = "Giriş Yap";
}

<style>

    body {
        margin: 0;
        height: 100vh;
        background: linear-gradient(135deg,#0f172a,#1e293b);
        font-family: 'Segoe UI', sans-serif;
    }


    .login-container {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }


    .login-card {
        width: 420px;
        padding: 45px;
        background: #ffffff;
        border-radius: 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        text-align: center;
    }


    .logo {
        font-size: 55px;
        margin-bottom: 10px;
    }


    h1 {
        color: #0f172a;
        margin-bottom: 5px;
        font-size: 32px;
    }


    .subtitle {
        color: #64748b;
        margin-bottom: 35px;
    }


    .input-box {
        position: relative;
        margin-bottom: 20px;
    }


        .input-box span {
            position: absolute;
            left: 15px;
            top: 13px;
            font-size: 22px;
        }


    input {
        width: 100%;
        padding: 15px 15px 15px 50px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-size: 16px;
        box-sizing: border-box;
        outline: none;
    }


        input:focus {
            border-color: #ec4899;
            box-shadow: 0 0 8px rgba(236,72,153,0.25);
        }


    button {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 15px;
        background: linear-gradient(135deg,#ec4899,#f9a8d4);
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        transition: .3s;
    }


        button:hover {
            transform: scale(1.03);
            box-shadow: 0 10px 25px rgba(236,72,153,0.35);
        }


    .footer {
        margin-top: 25px;
        color: #94a3b8;
        font-size: 14px;
    }

</style>


<div class="login-container">

    <div class="login-card">


        <div class="logo">
            🏨
        </div>


        <h1>
            HotelOS
        </h1>


        <div class="subtitle">
            Otel Yönetim Sistemine Hoş Geldiniz
        </div>



        <form method="post">

            @if (ViewBag.Error != null)
            {
                <p style="color:red; margin-bottom:15px;">
                    @ViewBag.Error
                </p>
            }


            <div class="input-box">

                <span>📧</span>

                <input type="email"
                       name="email"
                       placeholder="E-posta" />

            </div>



            <div class="input-box">

                <span>🔒</span>

                <input type="password"
                       name="password"
                       placeholder="Şifre" />

            </div>



            <button type="submit">
                Giriş Yap
            </button>

        </form>



        <div class="footer">
            © 2026 HotelOS
        </div>


    </div>

</div>
```
