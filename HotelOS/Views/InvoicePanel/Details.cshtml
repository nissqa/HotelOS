@model HotelOS.Models.Invoice

@{
    ViewData["Title"] = "Fatura Detayı";
}

<div class="invoice-details-page">

    ```
    <div class="page-header">
        <div>
            <h1>📄 Fatura Detayı</h1>
            <p>Fatura bilgilerini ve rezervasyon detaylarını görüntüleyin.</p>
        </div>

        <a asp-controller="InvoicePanel"
           asp-action="Index"
           class="back-btn">
            ← Faturalara Dön
        </a>
    </div>

    <div class="invoice-card">

        <div class="invoice-top">
            <div>
                <span class="label">Fatura No</span>
                <h2>@(Model.InvoiceNo ?? "Belirtilmemiş")</h2>
            </div>

            <div class="invoice-icon">
                📄
            </div>
        </div>

        <div class="divider"></div>

        <div class="info-grid">

            <div class="info-box">
                <span>Rezervasyon No</span>
                <strong>#@Model.ReservationId</strong>
            </div>

            <div class="info-box">
                <span>Fatura Tarihi</span>
                <strong>@Model.IssueDate.ToString("dd.MM.yyyy HH:mm")</strong>
            </div>

            <div class="info-box">
                <span>Müşteri</span>
                <strong>
                    @if (Model.Reservation?.Customer != null)
                    {
                        @($"{Model.Reservation.Customer.FirstName} {Model.Reservation.Customer.LastName}")
                    }
                    else
                    {
                        @("Belirtilmemiş")
                    }
                </strong>
            </div>

            <div class="info-box">
                <span>Oda</span>
                <strong>
                    🛏️ @(Model.Reservation?.Room?.RoomNumber ?? "-")
                </strong>
            </div>

            <div class="info-box">
                <span>Toplam Tutar</span>
                <strong class="amount">
                    ₺@Model.TotalAmount.ToString("N2")
                </strong>
            </div>

            <div class="info-box">
                <span>Vergi</span>
                <strong>
                    ₺@Model.Tax.ToString("N2")
                </strong>
            </div>

        </div>

        <div class="total-box">
            <div>
                <span>Fatura Toplamı</span>
                <small>Vergiler dahil toplam tutar</small>
            </div>

            <strong>
                ₺@Model.TotalAmount.ToString("N2")
            </strong>
        </div>

    </div>
    ```

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        background: #f5f7fb;
        color: #1f2937;
    }

    .invoice-details-page {
        padding: 30px;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
        }

        .page-header p {
            margin-top: 7px;
            color: #6b7280;
        }

    .back-btn {
        background: #eef2ff;
        color: #4338ca;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 9px;
        font-weight: 600;
        transition: .2s;
    }

        .back-btn:hover {
            background: #e0e7ff;
            transform: translateY(-1px);
        }

    .invoice-card {
        max-width: 900px;
        background: white;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    .invoice-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .label {
        display: block;
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .invoice-top h2 {
        margin: 0;
        font-size: 25px;
        color: #312e81;
    }

    .invoice-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: #ede9fe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .divider {
        height: 1px;
        background: #eee;
        margin: 25px 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .info-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 17px;
    }

        .info-box span {
            display: block;
            color: #6b7280;
            font-size: 12px;
            margin-bottom: 7px;
        }

        .info-box strong {
            font-size: 15px;
            color: #1f2937;
        }

        .info-box .amount {
            color: #15803d;
            font-size: 18px;
        }

    .total-box {
        margin-top: 25px;
        padding: 20px;
        border-radius: 13px;
        background: #eef2ff;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .total-box span {
            display: block;
            font-weight: 700;
            color: #3730a3;
            font-size: 16px;
        }

        .total-box small {
            display: block;
            color: #6b7280;
            margin-top: 4px;
        }

        .total-box strong {
            font-size: 25px;
            color: #312e81;
        }

    @@media (max-width: 700px) {

        .invoice-details-page {
            padding: 20px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .invoice-card {
            padding: 20px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .total-box {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }

</style>
