@model IEnumerable<HotelOS.Models.Reservation>

@{
    ViewData["Title"] = "Check-out";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f7fb;
        font-family: "Segoe UI", Arial, sans-serif;
        color: #1e293b;
    }

    .page {
        padding: 35px;
        min-height: 100vh;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .title h1 {
        margin: 0;
        font-size: 30px;
        color: #172554;
    }

    .title p {
        margin-top: 8px;
        color: #64748b;
    }

    .back-btn {
        text-decoration: none;
        background: white;
        color: #334155;
        padding: 11px 17px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,.06);
        font-weight: 600;
    }

    .message {
        padding: 15px 18px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .success {
        background: #dcfce7;
        color: #15803d;
    }

    .error {
        background: #fee2e2;
        color: #b91c1c;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .checkout-card {
        background: white;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .guest {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .guest-name {
        font-size: 17px;
        font-weight: 700;
        color: #172554;
    }

    .reservation-id {
        margin-top: 4px;
        font-size: 12px;
        color: #64748b;
    }

    .status {
        background: #dcfce7;
        color: #15803d;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 20px;
    }

    .detail {
        background: #f8fafc;
        padding: 14px;
        border-radius: 11px;
    }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        font-weight: 600;
    }

    .room {
        margin-top: 15px;
        padding: 15px;
        background: #eff6ff;
        border-radius: 12px;
        color: #1d4ed8;
        font-weight: 700;
    }

    .checkout-form {
        margin-top: 20px;
    }

    .checkout-btn {
        width: 100%;
        border: none;
        padding: 13px;
        border-radius: 11px;
        background: #dc2626;
        color: white;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .checkout-btn:hover {
            background: #b91c1c;
            transform: translateY(-1px);
        }

    .empty {
        background: white;
        border-radius: 18px;
        padding: 70px 30px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
    }

    .empty-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    .empty h2 {
        color: #334155;
        margin-bottom: 8px;
    }

    .empty p {
        color: #64748b;
    }

    @@media (max-width: 850px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .page {
            padding: 20px;
        }

        .header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page">

    ```
    <div class="header">

        <div class="title">
            <h1>🚶 Check-out</h1>
            <p>Konaklamasını tamamlayan müşterilerin çıkış işlemlerini yönetin.</p>
        </div>

        <a href="/Reception" class="back-btn">
            ← Ana Sayfa
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="message success">
            ✓ @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="message error">
            ⚠ @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty">

            <div class="empty-icon">🏨</div>

            <h2>Aktif konaklayan müşteri yok</h2>

            <p>
                Şu anda check-out yapılabilecek aktif bir rezervasyon bulunmuyor.
            </p>

        </div>
    }
    else
    {
        <div class="checkout-grid">

            @foreach (var reservation in Model)
            {
                var customerName =
                $"{reservation.Customer?.FirstName} {reservation.Customer?.LastName}";

                var initials =
                $"{reservation.Customer?.FirstName?.FirstOrDefault()}{reservation.Customer?.LastName?.FirstOrDefault()}";

                <div class="checkout-card">

                    <div class="card-top">

                        <div class="guest">

                            <div class="avatar">
                                @initials
                            </div>

                            <div>

                                <div class="guest-name">
                                    @customerName
                                </div>

                                <div class="reservation-id">
                                    Rezervasyon #@reservation.Id
                                </div>

                            </div>

                        </div>

                        <span class="status">
                            Konaklıyor
                        </span>

                    </div>

                    <div class="details">

                        <div class="detail">

                            <div class="detail-label">
                                Giriş Tarihi
                            </div>

                            <div class="detail-value">
                                @reservation.CheckIn.ToString("dd.MM.yyyy HH:mm")
                            </div>

                        </div>

                        <div class="detail">

                            <div class="detail-label">
                                Çıkış Tarihi
                            </div>

                            <div class="detail-value">
                                @reservation.CheckOut.ToString("dd.MM.yyyy HH:mm")
                            </div>

                        </div>

                        <div class="detail">

                            <div class="detail-label">
                                Yetişkin
                            </div>

                            <div class="detail-value">
                                @reservation.AdultCount kişi
                            </div>

                        </div>

                        <div class="detail">

                            <div class="detail-label">
                                Çocuk
                            </div>

                            <div class="detail-value">
                                @reservation.ChildCount kişi
                            </div>

                        </div>

                    </div>

                    <div class="room">
                        🛏️ Oda @reservation.Room?.RoomNumber
                    </div>

                    <form action="/CheckOut/CheckOut"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@reservation.Id" />

                        <button type="submit" class="checkout-btn">
                            🚶 Check-out Yap
                        </button>

                    </form>

                </div>
            }

        </div>
    }
    ```

</div>
