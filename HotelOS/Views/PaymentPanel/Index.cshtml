        .modal-info-grid {
            grid-template-columns: 1fr;
        }

        .payment-modal-content {
            max-height: 90vh;
            overflow-y: auto;
        }
    }
</style>

<script>
    let currentFilter = "all";
    let selectedPaymentId = null;

    const searchInput = document.getElementById("paymentSearch");
    const filterButtons = document.querySelectorAll(".stat-button");
    const clearFilter = document.getElementById("clearFilter");
    const filterTitle = document.getElementById("filterTitle");
    const filterDescription = document.getElementById("filterDescription");
    const resultText = document.getElementById("resultText");
    const noResultsRow = document.getElementById("noResultsRow");

    const paymentActionModal = document.getElementById("paymentActionModal");
    const modalLoading = document.getElementById("modalLoading");
    const paymentDetailsContent = document.getElementById("paymentDetailsContent");
    const cancelPaymentBtn = document.getElementById("cancelPaymentBtn");

    filterButtons.forEach(button => {
        button.addEventListener("click", function () {
            currentFilter = this.getAttribute("data-filter");

            filterButtons.forEach(btn => {
                btn.classList.remove("active-card");
            });

            this.classList.add("active-card");

            applyFilters();
        });
    });

    clearFilter.addEventListener("click", function () {
        currentFilter = "all";

        filterButtons.forEach(btn => {
            btn.classList.remove("active-card");
        });

        const allButton = document.querySelector('.stat-button[data-filter="all"]');

        if (allButton) {
            allButton.classList.add("active-card");
        }

        if (searchInput) {
            searchInput.value = "";
        }

        applyFilters();
    });

    if (searchInput) {
        searchInput.addEventListener("input", applyFilters);
    }

    function applyFilters() {
        const rows = document.querySelectorAll(".payment-row");

        const searchText = searchInput
            ? searchInput.value.toLowerCase().trim()
            : "";

        const now = new Date();

        const today =
            now.getFullYear() +
            "-" +
            String(now.getMonth() + 1).padStart(2, "0") +
            "-" +
            String(now.getDate()).padStart(2, "0");

        let visibleCount = 0;

        rows.forEach(row => {
            const status = (row.dataset.status || "").trim();
            const date = row.dataset.date || "";
            const text = row.innerText.toLowerCase();

            let matchesFilter = true;

            if (currentFilter === "today") {
                matchesFilter = date === today;
            }
            else if (currentFilter === "paid") {
                matchesFilter = status === "Ödendi";
            }
            else if (currentFilter === "pending") {
                matchesFilter = status === "Bekliyor";
            }

            const matchesSearch = text.includes(searchText);
            const show = matchesFilter && matchesSearch;

            row.style.display = show ? "" : "none";

            if (show) {
                visibleCount++;
            }
        });

        if (noResultsRow) {
            noResultsRow.style.display =
                visibleCount === 0 ? "" : "none";
        }

        updateFilterText(visibleCount);
    }

    function updateFilterText(count) {
        if (currentFilter === "all") {
            filterTitle.innerText = "💰 Tüm Ödemeler";
            filterDescription.innerText =
                "Sistemdeki tüm ödeme kayıtları gösteriliyor.";
        }
        else if (currentFilter === "today") {
            filterTitle.innerText = "📅 Bugünkü Ödemeler";
            filterDescription.innerText =
                "Bugün gerçekleştirilen ödeme işlemleri gösteriliyor.";
        }
        else if (currentFilter === "paid") {
            filterTitle.innerText = "✓ Ödenen İşlemler";
            filterDescription.innerText =
                "Durumu 'Ödendi' olan ödeme işlemleri gösteriliyor.";
        }
        else if (currentFilter === "pending") {
            filterTitle.innerText = "⏳ Bekleyen İşlemler";
            filterDescription.innerText =
                "Durumu 'Bekliyor' olan ödeme işlemleri gösteriliyor.";
        }

        resultText.innerText =
            count === 0
                ? "Bu filtreye uygun ödeme bulunamadı."
                : count + " ödeme işlemi gösteriliyor.";
    }

    async function openPaymentActions(paymentId) {
        selectedPaymentId = paymentId;

        paymentActionModal.classList.add("show");

        modalLoading.style.display = "block";
        modalLoading.innerText = "Ödeme bilgileri getiriliyor...";
        paymentDetailsContent.style.display = "none";

        try {
            const response = await fetch(
                `/api/payments/${paymentId}`,
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            if (!response.ok) {
                throw new Error("Ödeme bilgileri alınamadı.");
            }

            const data = await response.json();

            if (!data.success) {
                throw new Error(
                    data.message || "Ödeme bulunamadı."
                );
            }

            document.getElementById("modalCustomer").innerText =
                data.customer || "-";

            document.getElementById("modalRoom").innerText =
                data.room || "-";

            document.getElementById("modalAmount").innerText =
                "₺" +
                Number(data.amount).toLocaleString(
                    "tr-TR",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            document.getElementById("modalPaymentMethod").innerText =
                data.paymentMethod || "-";

            document.getElementById("modalPaymentDate").innerText =
                data.paymentDate || "-";

            document.getElementById("modalTransactionNo").innerText =
                data.transactionNo || "-";

            document.getElementById("modalStatus").innerText =
                data.status || "-";

            document.getElementById("modalReservation").innerText =
                "#" + (data.reservationId || "-");

            document.getElementById("modalTransaction").innerText =
                data.transactionNo
                    ? "İşlem No: " + data.transactionNo
                    : "Ödeme #" + data.id;

            if (data.status === "İptal") {
                cancelPaymentBtn.style.display = "none";
            }
            else {
                cancelPaymentBtn.style.display = "block";
            }

            modalLoading.style.display = "none";
            paymentDetailsContent.style.display = "block";
        }
        catch (error) {
            modalLoading.innerText = "❌ " + error.message;
        }
    }

    function closePaymentModal() {
        paymentActionModal.classList.remove("show");
        selectedPaymentId = null;
    }

    paymentActionModal.addEventListener("click", function (event) {
        if (event.target === paymentActionModal) {
            closePaymentModal();
        }
    });

    cancelPaymentBtn.addEventListener("click", async function () {
        if (!selectedPaymentId) {
            return;
        }

        const confirmed = confirm(
            "Bu ödemeyi iptal etmek istediğinize emin misiniz?"
        );

        if (!confirmed) {
            return;
        }

        try {
            cancelPaymentBtn.disabled = true;
            cancelPaymentBtn.innerText = "⏳ İptal ediliyor...";

            const response = await fetch(
                `/api/payments/${selectedPaymentId}/cancel`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    }
                }
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message || "Ödeme iptal edilemedi."
                );
            }

            alert("✅ Ödeme başarıyla iptal edildi.");

            closePaymentModal();
            location.reload();
        }
        catch (error) {
            alert("❌ " + error.message);

            cancelPaymentBtn.disabled = false;
            cancelPaymentBtn.innerText = "❌ Ödemeyi İptal Et";
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closePaymentModal();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        applyFilters();
    });
</script>