@model List<HotelOS.Models.Payment>

@{
    ViewData["Title"] = "Ödemeler";
}

<div class="payments-page">

    <div class="page-header">
        <div>
            <h1>💳 Ödemeler</h1>
            <p>Otel ödeme işlemlerini ve ödeme durumlarını yönetin.</p>
        </div>
    </div>

    <div class="stats">

        <button type="button"
                class="stat-card stat-button active-card"
                data-filter="all">

            <div class="stat-icon purple">💰</div>

            <div class="stat-content">
                <span>Toplam Ödeme</span>
                <strong>
                    ₺@Convert.ToDecimal(ViewBag.TotalPayments ?? 0).ToString("N0")
                </strong>
                <small>Tüm ödemeleri görüntüle →</small>
            </div>

        </button>

        <button type="button"
                class="stat-card stat-button"
                data-filter="today">

            <div class="stat-icon blue">📅</div>

            <div class="stat-content">
                <span>Bugünkü Ödeme</span>
                <strong>
                    ₺@Convert.ToDecimal(ViewBag.TodayPayments ?? 0).ToString("N0")
                </strong>
                <small>Bugünkü ödemeleri görüntüle →</small>
            </div>

        </button>

        <button type="button"
                class="stat-card stat-button"
                data-filter="paid">

            <div class="stat-icon green">✓</div>

            <div class="stat-content">
                <span>Ödenen İşlemler</span>
                <strong>
                    @ViewBag.PaidPayments
                </strong>
                <small>Ödenen işlemleri görüntüle →</small>
            </div>

        </button>

        <button type="button"
                class="stat-card stat-button"
                data-filter="pending">

            <div class="stat-icon orange">⏳</div>

            <div class="stat-content">
                <span>Bekleyen İşlemler</span>
                <strong>
                    @ViewBag.PendingPayments
                </strong>
                <small>Bekleyen işlemleri görüntüle →</small>
            </div>

        </button>

    </div>

    <div id="filterPanel" class="filter-panel">

        <div>
            <strong id="filterTitle">Tüm Ödemeler</strong>
            <span id="filterDescription">
                Sistemdeki tüm ödeme kayıtları gösteriliyor.
            </span>
        </div>

        <button type="button" id="clearFilter">
            ✕ Filtreyi Temizle
        </button>

    </div>

    <div class="table-card">

        <div class="table-top">

            <div>
                <h2>Ödeme Listesi</h2>
                <p id="resultText">
                    Sistemde kayıtlı ödeme işlemleri
                </p>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text"
                       id="paymentSearch"
                       placeholder="Müşteri, oda, işlem no veya ödeme yöntemi ara..." />
            </div>

        </div>

        <div class="table-container">

            <table id="paymentTable">

                <thead>
                    <tr>
                        <th>Müşteri</th>
                        <th>Oda</th>
                        <th>Tutar</th>
                        <th>Ödeme Yöntemi</th>
                        <th>Ödeme Tarihi</th>
                        <th>İşlem No</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var payment in Model)
                        {
                            var customer = payment.Reservation?.Customer;

                            var customerName = customer != null
                            ? $"{customer.FirstName} {customer.LastName}"
                            : "Bilinmiyor";

                            var roomNumber = payment.Reservation?.Room?.RoomNumber ?? "-";

                            var status = payment.Status ?? "Belirsiz";

                            var firstLetter = customer != null &&
                            !string.IsNullOrEmpty(customer.FirstName)
                            ? customer.FirstName.Substring(0, 1).ToUpper()
                            : "?";

                            var lastLetter = customer != null &&
                            !string.IsNullOrEmpty(customer.LastName)
                            ? customer.LastName.Substring(0, 1).ToUpper()
                            : "";

                            <tr class="payment-row"
                                data-status="@status"
                                data-date="@payment.PaymentDate.ToString("yyyy-MM-dd")">

                                <td>
                                    <div class="customer-info">

                                        <div class="avatar">
                                            @firstLetter@lastLetter
                                        </div>

                                        <div>
                                            <strong>@customerName</strong>

                                            @if (payment.Reservation != null)
                                            {
                                                <small>
                                                    Rezervasyon #@payment.Reservation.Id
                                                </small>
                                            }
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="room-badge">
                                        🛏️ @roomNumber
                                    </span>
                                </td>

                                <td>
                                    <strong class="amount">
                                        ₺@payment.Amount.ToString("N2")
                                    </strong>
                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(payment.PaymentMethod))
                                    {
                                        <span class="muted">-</span>
                                    }
                                    else if (payment.PaymentMethod.Contains(
                                    "kart",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="payment-method">
                                            💳 @payment.PaymentMethod
                                        </span>
                                    }
                                    else if (payment.PaymentMethod.Contains(
                                    "nakit",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="payment-method">
                                            💵 @payment.PaymentMethod
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="payment-method">
                                            💰 @payment.PaymentMethod
                                        </span>
                                    }

                                </td>

                                <td>
                                    <div class="date-info">
                                        <strong>
                                            @payment.PaymentDate.ToString("dd.MM.yyyy")
                                        </strong>

                                        <small>
                                            @payment.PaymentDate.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(payment.TransactionNo))
                                    {
                                        <span class="transaction">
                                            @payment.TransactionNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }

                                </td>

                                <td>

                                    @if (payment.Status == "Ödendi")
                                    {
                                        <span class="status paid">
                                            ● Ödendi
                                        </span>
                                    }
                                    else if (payment.Status == "Bekliyor")
                                    {
                                        <span class="status pending">
                                            ● Bekliyor
                                        </span>
                                    }
                                    else if (payment.Status == "İptal")
                                    {
                                        <span class="status cancelled">
                                            ● İptal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status unknown">
                                            ● @status
                                        </span>
                                    }

                                </td>

                                <td>
                                    <button type="button"
                                            class="action-btn"
                                            onclick="openPaymentActions(@payment.Id)">
                                        ⚙️ İşlem
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyDatabaseRow">
                            <td colspan="8">

                                <div class="empty">
                                    <div class="empty-icon">💳</div>

                                    <strong>
                                        Henüz ödeme bulunmuyor
                                    </strong>

                                    <span>
                                        Sistemde kayıtlı herhangi bir ödeme işlemi bulunmamaktadır.
                                    </span>
                                </div>

                            </td>
                        </tr>
                    }

                    <tr id="noResultsRow" style="display:none;">
                        <td colspan="8">

                            <div class="empty">
                                <div class="empty-icon">🔍</div>

                                <strong>
                                    Sonuç bulunamadı
                                </strong>

                                <span>
                                    Seçtiğiniz filtre veya arama kriterlerine uygun ödeme bulunamadı.
                                </span>
                            </div>

                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<div id="paymentActionModal" class="payment-modal">

    <div class="payment-modal-content">

        <div class="payment-modal-header">

            <div>
                <h3>💳 Ödeme İşlemi</h3>

                <span id="modalTransaction">
                    İşlem bilgileri
                </span>
            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closePaymentModal()">
                ✕
            </button>

        </div>

        <div class="payment-modal-body">

            <div class="modal-loading" id="modalLoading">
                Ödeme bilgileri getiriliyor...
            </div>

            <div id="paymentDetailsContent" style="display:none;">

                <div class="modal-info-grid">

                    <div class="modal-info-item">
                        <span>Müşteri</span>
                        <strong id="modalCustomer">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Oda</span>
                        <strong id="modalRoom">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Tutar</span>
                        <strong id="modalAmount">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Ödeme Yöntemi</span>
                        <strong id="modalPaymentMethod">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Ödeme Tarihi</span>
                        <strong id="modalPaymentDate">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>İşlem No</span>
                        <strong id="modalTransactionNo">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Durum</span>
                        <strong id="modalStatus">-</strong>
                    </div>

                    <div class="modal-info-item">
                        <span>Rezervasyon</span>
                        <strong id="modalReservation">-</strong>
                    </div>

                </div>

                <div class="modal-actions">

                    <button type="button"
                            id="cancelPaymentBtn"
                            class="cancel-payment-btn">
                        ❌ Ödemeyi İptal Et
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

