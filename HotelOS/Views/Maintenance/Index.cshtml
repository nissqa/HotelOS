@model List<HotelOS.Models.MaintenanceRequest>


@{
    ViewData["Title"] = "Bakım Paneli";

    var activeTasks = Model?
        .Where(x => x.Status != "Tamamlandı" && x.Status != "İptal")
        .ToList()
        ?? new List<HotelOS.Models.MaintenanceRequest>();

    var completedTasks = ViewBag.CompletedRequests as List<HotelOS.Models.MaintenanceRequest>
        ?? new List<HotelOS.Models.MaintenanceRequest>();

    var maintenanceEmployees =
        ViewBag.MaintenanceEmployees as List<HotelOS.Models.Employee>
        ?? new List<HotelOS.Models.Employee>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Bakım Paneli - HotelOS</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f6f8;
            color: #1f2937;
        }

        .maintenance-page {
            min-height: 100vh;
            padding: 30px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .title-area h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: #111827;
        }

        .title-area p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .profile-box {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px 18px;
            color: #374151;
            font-size: 14px;
        }

            .profile-box strong {
                color: #111827;
            }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 22px;
        }

        .stat-label {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .stat-number {
            font-size: 30px;
            font-weight: 700;
            color: #111827;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

            .section-header h2 {
                margin: 0;
                font-size: 21px;
                color: #111827;
            }

            .section-header span {
                font-size: 13px;
                color: #6b7280;
            }

        .task-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 18px;
        }

        .task-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            padding: 20px;
            transition: 0.2s ease;
        }

            .task-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
            }

        .task-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 16px;
        }

        .room-number {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
        }

        .task-title {
            margin-top: 5px;
            font-size: 14px;
            color: #6b7280;
        }

        .priority {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            background: #f3f4f6;
            color: #374151;
            white-space: nowrap;
        }

        .priority-acil,
        .priority-cok-acil {
            background: #fee2e2;
            color: #b91c1c;
        }

        .priority-yuksek {
            background: #ffedd5;
            color: #c2410c;
        }

        .priority-normal {
            background: #e0f2fe;
            color: #0369a1;
        }

        .priority-dusuk {
            background: #dcfce7;
            color: #15803d;
        }

        .task-description {
            min-height: 48px;
            margin-bottom: 16px;
            color: #4b5563;
            font-size: 14px;
            line-height: 1.5;
        }

        .task-info {
            border-top: 1px solid #f0f0f0;
            padding-top: 14px;
            margin-bottom: 16px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 7px;
            font-size: 13px;
        }

        .info-label {
            color: #9ca3af;
        }

        .info-value {
            color: #374151;
            text-align: right;
            font-weight: 500;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        .btn {
            flex: 1;
            border: none;
            border-radius: 9px;
            padding: 10px 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
        }

        .btn-detail {
            background: #f3f4f6;
            color: #374151;
        }

            .btn-detail:hover {
                background: #e5e7eb;
            }

        .btn-complete {
            background: #111827;
            color: #ffffff;
        }

            .btn-complete:hover {
                background: #374151;
            }

        .empty-state {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            padding: 45px 20px;
            text-align: center;
            color: #6b7280;
        }

        .empty-icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .history-section {
            margin-top: 42px;
        }

        .history-list {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            overflow: hidden;
        }

        .history-item {
            display: grid;
            grid-template-columns: 100px 1fr 130px 110px;
            align-items: center;
            gap: 15px;
            padding: 17px 20px;
            border-bottom: 1px solid #f0f0f0;
        }

            .history-item:last-child {
                border-bottom: none;
            }

        .history-room {
            font-weight: 700;
            color: #111827;
        }

        .history-title {
            color: #374151;
            font-size: 14px;
        }

        .history-date {
            color: #9ca3af;
            font-size: 12px;
        }

        .completed-badge {
            display: inline-block;
            background: #dcfce7;
            color: #15803d;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-align: center;
        }

        .alert {
            border-radius: 10px;
            padding: 13px 16px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        @@media (max-width: 800px) {
            .maintenance-page {
                padding: 18px;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .history-item {
                grid-template-columns: 1fr;
                gap: 6px;
            }
        }
    </style>
</head>

<body>

    <div class="maintenance-page">

        <div class="topbar">
            <div class="title-area">
                <h1>Bakım Paneli</h1>
                <p>Size atanmış bakım görevlerini buradan takip edebilirsiniz.</p>
            </div>

            <div class="profile-box">
                🔧 <strong>Bakım Görevlisi</strong>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }

        <div class="stats">

            <div class="stat-card">
                <div class="stat-label">Aktif Görevler</div>
                <div class="stat-number">@activeTasks.Count</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Tamamlanan Görevler</div>
                <div class="stat-number">@completedTasks.Count</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Toplam Görev</div>
                <div class="stat-number">
                    @(activeTasks.Count + completedTasks.Count)
                </div>
            </div>

        </div>

      

        <div class="section-header">
            <h2>Aktif Görevler</h2>
            <span>@activeTasks.Count görev</span>
        </div>

        @if (activeTasks.Any())
        {
            <div class="task-grid">

                @foreach (var task in activeTasks)
                {
                    var priorityClass = (task.Priority ?? "")
                    .ToLower()
                    .Replace(" ", "-")
                    .Replace("ı", "i")
                    .Replace("ş", "s")
                    .Replace("ç", "c")
                    .Replace("ö", "o")
                    .Replace("ü", "u")
                    .Replace("ğ", "g");

                    <div class="task-card">

                        <div class="task-top">

                            <div>
                                <div class="room-number">
                                    Oda @(task.Room?.RoomNumber ?? "-")
                                </div>

                                <div class="task-title">
                                    @(task.Title ?? "Bakım Görevi")
                                </div>
                            </div>

                            <span class="priority priority-@priorityClass">
                                @(task.Priority ?? "Normal")
                            </span>

                        </div>

                        <div class="task-description">
                            @(string.IsNullOrWhiteSpace(task.Description)
                                                ? "Açıklama bulunmuyor."
                                                : task.Description)
                </div>

                        <div class="task-info">

                            <div class="info-row">
                                <span class="info-label">Durum</span>
                                <span class="info-value">
                                    @(task.Status ?? "Bekliyor")
                                </span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">Oluşturulma</span>
                                <span class="info-value">
                                    @task.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>

                        </div>

                        <div class="actions">

                            <a class="btn btn-detail"
                               href="@Url.Action("Details", "Maintenance", new { id = task.Id })">
                                Detay
                            </a>

                            <form method="post"
                                  action="@Url.Action("Complete", "Maintenance")"
                                  style="flex:1;"
                                  onsubmit="return confirm('Bu bakım görevini tamamlandı olarak işaretlemek istiyor musunuz?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@task.Id" />

                                <button type="submit"
                                        class="btn btn-complete"
                                        style="width:100%;">
                                    Tamamla
                                </button>

                            </form>

                        </div>

                    </div>
                        }

            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">✓</div>
                <strong>Aktif bakım göreviniz bulunmuyor.</strong>
                <div style="margin-top:7px;">
                    Size yeni bir görev atandığında burada görünecek.
                </div>
            </div>
        }



        <div class="history-section">

            <div class="section-header">
                <h2>Geçmiş Görevler</h2>
                <span>Tamamlanan görevler</span>
            </div>

            @if (completedTasks.Any())
            {
                <div class="history-list">

                    @foreach (var task in completedTasks)
                    {
                        <div class="history-item">

                            <div class="history-room">
                                Oda @(task.Room?.RoomNumber ?? "-")
                            </div>

                            <div class="history-title">
                                @(task.Title ?? "Bakım Görevi")
                            </div>

                            <div class="history-date">
                                @task.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>

                            <div>
                                <span class="completed-badge">
                                    @(task.Status == "İptal" ? "İptal" : "Tamamlandı")
                                </span>
                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">
                    Henüz geçmiş bakım göreviniz bulunmuyor.
                </div>
            }

        </div>

    </div>

</body>
</html>
```
