@{
    ViewData["Title"] = "Temizlik Görevi Oluştur";

    var rooms = ViewBag.Rooms as List<HotelOS.Models.Room>
        ?? new List<HotelOS.Models.Room>();

    var employees = ViewBag.Employees as List<HotelOS.Models.Employee>
        ?? new List<HotelOS.Models.Employee>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>HotelOS - Temizlik Görevi</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #1f2937;
        }

        .page {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 25px;
        }

        .back {
            display: inline-block;
            margin-bottom: 20px;
            color: #4f46e5;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

            .back:hover {
                color: #3730a3;
            }

        .header {
            margin-bottom: 25px;
        }

        .badge {
            display: inline-block;
            background: #ede9fe;
            color: #6d28d9;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header h1 {
            font-size: 30px;
            margin-bottom: 7px;
        }

        .header p {
            color: #6b7280;
            font-size: 14px;
        }

        .message {
            padding: 13px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .success {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
        }

        .form-card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .full {
            grid-column: 1 / -1;
        }

        label {
            font-size: 12px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 7px;
        }

        select,
        input,
        textarea {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 12px 13px;
            font-size: 13px;
            outline: none;
            background: white;
            color: #1f2937;
        }

            select:focus,
            input:focus,
            textarea:focus {
                border-color: #4f46e5;
                box-shadow: 0 0 0 3px rgba(79,70,229,0.08);
            }

        select {
            cursor: pointer;
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        .employee-info {
            margin-top: 8px;
            color: #64748b;
            font-size: 11px;
        }

        .no-employee {
            margin-top: 8px;
            padding: 9px 11px;
            background: #fff7ed;
            color: #9a3412;
            border-radius: 8px;
            font-size: 11px;
            line-height: 1.4;
        }

        .info-box {
            margin-top: 22px;
            padding: 14px;
            border-radius: 11px;
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
        }

        .buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
        }

        .btn {
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .cancel {
            background: #f1f5f9;
            color: #475569;
        }

            .cancel:hover {
                background: #e2e8f0;
            }

        .save {
            background: #4f46e5;
            color: white;
        }

            .save:hover {
                background: #4338ca;
            }

        .empty {
            padding: 15px;
            background: #fff7ed;
            color: #9a3412;
            border-radius: 10px;
            font-size: 12px;
        }

        @@media (max-width: 700px) {
            .page {
                padding: 25px 15px;
            }

            .form-card {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .full {
                grid-column: auto;
            }

            .buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <div class="page">

        <a href="/Admin/Index" class="back">
            ← Admin Paneline Dön
        </a>

        <div class="header">

            <div class="badge">
                🧹 TEMİZLİK YÖNETİMİ
            </div>

            <h1>Temizlik Görevi Oluştur</h1>

            <p>
                Temizlenecek odayı ve görevlendirilecek temizlik personelini seçin.
            </p>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="message success">
                ✓ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message error">
                ⚠ @TempData["Error"]
            </div>
        }

        <div class="form-card">

            @if (!rooms.Any())
            {
                <div class="empty">
                    ⚠ Sistemde kayıtlı oda bulunamadı.
                </div>
            }
            else
            {
                <form method="post" action="/CleaningManagement/AssignTask">

                    <div class="form-grid">

                        <div class="form-group">

                            <label for="roomId">
                                🛏️ Oda
                            </label>

                            <select id="roomId"
                                    name="roomId"
                                    required>

                                <option value="">
                                    Oda seçin
                                </option>

                                @foreach (var room in rooms)
                                {
                                    <option value="@room.Id">
                                        Oda @room.RoomNumber
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="form-group">

                            <label for="employeeId">
                                🧹 Temizlik Personeli
                            </label>

                            @if (employees.Any())
                            {
                                <select id="employeeId"
                                        name="employeeId"
                                        required>

                                    <option value="">
                                        Temizlik personeli seçin
                                    </option>

                                    @foreach (var employee in employees)
                                    {
                                        <option value="@employee.Id">
                                            @employee.FirstName @employee.LastName
                                        </option>
                                    }

                                </select>

                                <div class="employee-info">
                                    Aktif temizlik personelleri listelenmektedir.
                                </div>
                            }
                            else
                            {
                                <select id="employeeId"
                                        name="employeeId"
                                        disabled>

                                    <option>
                                        Aktif temizlik personeli bulunamadı
                                    </option>

                                </select>

                                <div class="no-employee">
                                    ⚠ Sistemde aktif temizlik personeli bulunmuyor.
                                    Önce personel yönetiminden temizlik personeli ekleyin.
                                </div>
                            }

                        </div>

                        <div class="form-group">

                            <label for="taskDate">
                                📅 Görev Tarihi
                            </label>

                            <input type="datetime-local"
                                   id="taskDate"
                                   name="taskDate"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                   required />

                        </div>

                        <div class="form-group">

                            <label for="status">
                                📌 Durum
                            </label>

                            <input type="text"
                                   id="status"
                                   value="Bekliyor"
                                   readonly />

                        </div>

                        <div class="form-group full">

                            <label for="notes">
                                📝 Not
                            </label>

                            <textarea id="notes"
                                  name="notes"
                                  placeholder="Örneğin: Check-out sonrası detaylı temizlik yapılacak."></textarea>

                        </div>

                    </div>

                    <div class="info-box">
                        <strong>Bilgi:</strong>
                        Görev oluşturulduğunda durum otomatik olarak
                        <strong>Bekliyor</strong> olacaktır.
                        Temizlik personeli kendi panelinden görevi görüp
                        temizliğe başlayabilir ve tamamlayabilir.
                    </div>

                    <div class="buttons">

                        <a href="/CleaningManagement/Index" class="btn cancel">İptal</a>

                        <button type="submit"
                                class="btn save">
                            🧹 Görevi Oluştur
                        </button>

                    </div>

                </form>
            }

        </div>

    </div>

</body>
</html>
