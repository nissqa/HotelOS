        }

        .status-badge.cleaning {
            background: #fef3c7;
            color: #b45309;
        }

        .status-badge.maintenance {
            background: #fee2e2;
            color: #b91c1c;
        }



    .room-number {
        font-size: 25px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .floor-info {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 17px;
    }

    .task-info {
        padding: 12px;
        border-radius: 10px;
        background: #f8fafc;
        margin-bottom: 12px;
    }

        .task-info span {
            display: block;
            color: #9ca3af;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .task-info strong {
            font-size: 12px;
        }



    .notes {
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: #6b7280;
        font-size: 11px;
        margin-bottom: 13px;
    }



    .card-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .action-btn {
        border: none;
        border-radius: 10px;
        padding: 11px 12px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .action-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none !important;
        }

    .start-btn {
        flex: 1;
        background: #4f46e5;
        color: white;
    }

        .start-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

    .complete-btn {
        flex: 1;
        background: #16a34a;
        color: white;
    }

        .complete-btn:hover {
            background: #15803d;
            transform: translateY(-1px);
        }

    .maintenance-btn {
        background: #fee2e2;
        color: #b91c1c;
    }

        .maintenance-btn:hover {
            background: #fecaca;
            transform: translateY(-1px);
        }



    .progress-area {
        margin-top: 13px;
        padding: 12px;
        background: #fffbeb;
