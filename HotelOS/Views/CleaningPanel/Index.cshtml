        height: 47px;
        border-radius: 13px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .yellow-icon {
        background: #fef3c7;
    }

    .red-icon {
        background: #fee2e2;
    }



    .status-badge {
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status-badge.waiting {
