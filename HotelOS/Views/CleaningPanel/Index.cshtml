@model List<HotelOS.Models.CleaningTask>

@{
    ViewData["Title"] = "Temizlik Paneli";

    var today = DateTime.Today;
    var fiveDaysAgo = today.AddDays(-5);

    var allTasks = Model ?? new List<HotelOS.Models.CleaningTask>();

    var waitingTasks = allTasks
        .Where(x => x.Status == "Bekliyor" && x.TaskDate.Date <= today)
        .OrderBy(x => x.TaskDate)
        .ToList();

    var cleaningTasks = allTasks
        .Where(x => x.Status == "Temizlikte")
        .OrderBy(x => x.TaskDate)
        .ToList();

    var completedTasks = allTasks
        .Where(x =>
            x.Status == "Temizlendi" &&
            x.TaskDate.Date >= fiveDaysAgo &&
            x.TaskDate.Date <= today)
        .OrderByDescending(x => x.TaskDate)
        .ToList();

    var maintenanceTasks = allTasks
        .Where(x => x.Status == "Bakım")
        .OrderByDescending(x => x.TaskDate)
        .ToList();

    var completedTodayCount = allTasks.Count(x =>
        x.Status == "Temizlendi" &&
        x.TaskDate.Date == today);
}

<div class="cleaning-page">


    <div class="page-header">
        <div>
            <div class="welcome-badge">
                🧹 TEMİZLİK PERSONELİ
            </div>

            <h1>Temizlik Paneli</h1>

            <p>
                Bugün temizlenmesi gereken odaları ve devam eden görevleri buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="today-box">
            <span>Bugün</span>
            <strong>@DateTime.Now.ToString("dd.MM.yyyy")</strong>
        </div>
    </div>


    <div class="stats">

        <div class="stat-card waiting-stat"
             onclick="goToSection('waiting-section')"
             role="button"
             tabindex="0">

            <div class="stat-icon">🧹</div>

            <div>
                <span>Temizlenecek</span>
                <strong>@waitingTasks.Count</strong>
                <small>Bekleyen oda</small>
            </div>

        </div>


        <div class="stat-card cleaning-stat"
             onclick="goToSection('cleaning-section')"
             role="button"
             tabindex="0">

            <div class="stat-icon">🟡</div>

            <div>
                <span>Devam Eden</span>
                <strong>@cleaningTasks.Count</strong>
                <small>Temizlik yapılıyor</small>
            </div>

        </div>


        <div class="stat-card completed-stat"
             onclick="goToSection('history-section')"
             role="button"
             tabindex="0">

            <div class="stat-icon">✓</div>

            <div>
                <span>Bugün Temizlenen</span>
                <strong>@completedTodayCount</strong>
                <small>Tamamlanan oda</small>
            </div>

        </div>


        <div class="stat-card maintenance-stat"
             onclick="goToSection('maintenance-section')"
             role="button"
             tabindex="0">

            <div class="stat-icon">🔧</div>

            <div>
                <span>Bakım Bekleyen</span>
                <strong>@maintenanceTasks.Count</strong>
                <small>Bakım bildirimi</small>
            </div>

        </div>

    </div>



    <section class="section" id="waiting-section">

        <div class="section-header">

            <div>
                <h2>🧹 Temizlenmesi Gereken Odalar</h2>

                <p>
                    Öncelikli olarak tamamlanması gereken temizlik görevleri
                </p>
            </div>

            <span class="count-badge">
                @waitingTasks.Count oda
            </span>

        </div>


        @if (waitingTasks.Any())
        {
            <div class="room-grid">

                @foreach (var task in waitingTasks)
                {
                    var roomNumber = task.Room?.RoomNumber ?? "-";

                    <div class="room-card waiting-card">

                        <div class="room-top">

                            <div class="room-icon">
                                🛏️
                            </div>

                            <span class="status-badge waiting">
                                🧹 Temizlenecek
                            </span>

                        </div>


                        <div class="room-number">
                            Oda @roomNumber
                        </div>


                        <div class="floor-info">
                            📍 Oda görevi
                        </div>


                        <div class="task-info">

                            <div>

                                <span>
                                    Görev tarihi
                                </span>

                                <strong>
                                    @task.TaskDate.ToString("dd.MM.yyyy HH:mm")
                                </strong>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(task.Notes))
                        {
                            <div class="notes">
                                💬 @task.Notes
                            </div>
                        }


                        <div class="card-actions">

                            <button type="button"
                                    class="action-btn start-btn"
                                    onclick="startCleaning(@task.Id)">

                                🧹 Temizliğe Başla

                            </button>


                            <button type="button"
                                    class="action-btn maintenance-btn"
                                    onclick="sendMaintenance(@task.Id)">

                                🔧 Bakıma Gönder

                            </button>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-box">

                <div class="empty-icon">
                    🎉
                </div>

                <strong>
                    Temizlenecek oda yok!
                </strong>

                <span>
                    Şu anda bekleyen bir temizlik görevi bulunmuyor.
                </span>

            </div>
        }

    </section>



    <section class="section" id="cleaning-section">

        <div class="section-header">

            <div>

                <h2>
                    🟡 Devam Eden Temizlikler
                </h2>

                <p>
                    Şu anda üzerinde çalışılan odalar
                </p>

            </div>

            <span class="count-badge yellow">
                @cleaningTasks.Count oda
            </span>

        </div>


        @if (cleaningTasks.Any())
        {
            <div class="room-grid">

                @foreach (var task in cleaningTasks)
                {
                    var roomNumber = task.Room?.RoomNumber ?? "-";

                    <div class="room-card cleaning-card">

                        <div class="room-top">

                            <div class="room-icon yellow-icon">
                                🧹
                            </div>

                            <span class="status-badge cleaning">
                                🟡 Temizlikte
                            </span>

                        </div>


                        <div class="room-number">
                            Oda @roomNumber
                        </div>


                        <div class="floor-info">
                            🧽 Temizlik devam ediyor
                        </div>


                        <div class="progress-area">

                            <div class="progress-label">

                                <span>
                                    Durum
                                </span>

                                <strong>
                                    Devam ediyor
                                </strong>

                            </div>


                            <div class="progress-bar">

                                <div class="progress-fill"></div>

                            </div>

                        </div>


                        <div class="card-actions">

                            <button type="button"
                                    class="action-btn complete-btn"
                                    onclick="completeCleaning(@task.Id)">

                                ✓ Temizliği Bitir

                            </button>


                            <button type="button"
                                    class="action-btn maintenance-btn"
                                    onclick="sendMaintenance(@task.Id)">

                                🔧 Bakıma Gönder

                            </button>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-box small-empty">

                <div class="empty-icon">
                    🧽
                </div>

                <strong>
                    Devam eden temizlik yok
                </strong>

                <span>
                    Şu anda üzerinde çalışılan oda bulunmuyor.
                </span>

            </div>
        }

    </section>


    <section class="section" id="maintenance-section">

        @if (maintenanceTasks.Any())
        {
            <div class="section-header">

                <div>

                    <h2>
                        🔧 Bakım Bekleyen Odalar
                    </h2>

                    <p>
                        Teknik ekip tarafından kontrol edilmesi gereken odalar
                    </p>

                </div>

                <span class="count-badge red">
                    @maintenanceTasks.Count oda
                </span>

            </div>


            <div class="room-grid">

                @foreach (var task in maintenanceTasks)
                {
                    var roomNumber = task.Room?.RoomNumber ?? "-";

                    <div class="room-card maintenance-card">

                        <div class="room-top">

                            <div class="room-icon red-icon">
                                🔧
                            </div>

                            <span class="status-badge maintenance">
                                🔧 Bakım
                            </span>

                        </div>


                        <div class="room-number">
                            Oda @roomNumber
                        </div>


                        <div class="floor-info">
                            Teknik kontrol bekliyor
                        </div>


                        @if (!string.IsNullOrWhiteSpace(task.Notes))
                        {
                            <div class="notes">
                                💬 @task.Notes
                            </div>
                        }


                        <div class="maintenance-message">

                            <strong>
                                Bakım bildirimi oluşturuldu.
                            </strong>

                            <span>
                                Oda teknik ekibe bildirildi.
                            </span>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="section-header">

                <div>

                    <h2>
                        🔧 Bakım Bekleyen Odalar
                    </h2>

                    <p>
                        Teknik ekip tarafından kontrol edilmesi gereken odalar
                    </p>

                </div>

                <span class="count-badge red">
                    0 oda
                </span>

            </div>


            <div class="empty-box small-empty">

                <div class="empty-icon">
                    🔧
                </div>

                <strong>
                    Bakım bekleyen oda yok
                </strong>

                <span>
                    Şu anda bakıma gönderilmiş bir oda bulunmuyor.
                </span>

            </div>
        }

    </section>



    <section class="section history-section" id="history-section">

        <div class="section-header">

            <div>

                <h2>
                    ✓ Son 5 Günde Temizlenenler
                </h2>

                <p>
                    Yakın zamanda tamamlanan temizlik görevleri
                </p>

            </div>

            <span class="count-badge green">
                @completedTasks.Count oda
            </span>

        </div>


        @if (completedTasks.Any())
        {
            <div class="completed-list">

                @foreach (var task in completedTasks)
                {
                    var roomNumber = task.Room?.RoomNumber ?? "-";

                    <div class="completed-item">

                        <div class="completed-icon">
                            ✓
                        </div>


                        <div class="completed-room">

                            <strong>
                                Oda @roomNumber
                            </strong>

                            <span>
                                Temizlik tamamlandı
                            </span>

                        </div>


                        <div class="completed-date">

                            <strong>
                                @task.TaskDate.ToString("dd.MM.yyyy")
                            </strong>

                            <span>
                                @task.TaskDate.ToString("HH:mm")
                            </span>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-box small-empty">

                <div class="empty-icon">
                    📋
                </div>

                <strong>
                    Son 5 günde tamamlanan görev yok
                </strong>

                <span>
                    Tamamlanan temizlikler burada görünecek.
                </span>

            </div>
        }

    </section>


    

    <div id="priorityModal"
         class="priority-modal-overlay"
         style="display:none;">

        <div class="priority-modal">

            <h3>
                Bakım Önceliği Seç
            </h3>

            <p>
                Bu oda için bakım önceliğini belirleyin.
            </p>


            <div class="priority-options">

                <button type="button"
                        class="priority-option normal"
                        onclick="confirmMaintenance('Normal')">

                    Normal

                </button>


                <button type="button"
                        class="priority-option acil"
                        onclick="confirmMaintenance('Acil')">

                    Acil

                </button>


                <button type="button"
                        class="priority-option cok-acil"
                        onclick="confirmMaintenance('Çok Acil')">

                    Çok Acil

                </button>

            </div>


            <button type="button"
                    class="priority-cancel"
                    onclick="closePriorityModal()">

                Vazgeç

            </button>

        </div>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f7fb;
        color: #1f2937;
    }

    .cleaning-page {
        padding: 30px;
        min-height: 100vh;
    }


    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .welcome-badge {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        background: #ede9fe;
        color: #6d28d9;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 750;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .today-box {
        background: white;
        border-radius: 13px;
        padding: 14px 20px;
        min-width: 145px;
        box-shadow: 0 4px 16px rgba(0,0,0,.05);
        text-align: center;
    }

        .today-box span {
            display: block;
            color: #9ca3af;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .today-box strong {
            font-size: 15px;
        }



    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 35px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        cursor: pointer;
        transition: .2s;
        border: 1px solid transparent;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 25px rgba(0,0,0,.09);
            border-color: #e5e7eb;
        }

        .stat-card:active {
            transform: translateY(-1px);
        }

        .stat-card:focus-visible {
            outline: 2px solid #4f46e5;
            outline-offset: 2px;
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .waiting-stat .stat-icon {
        background: #fef3c7;
    }

    .cleaning-stat .stat-icon {
        background: #fef3c7;
    }

    .completed-stat .stat-icon {
        background: #dcfce7;
    }

    .maintenance-stat .stat-icon {
        background: #fee2e2;
    }

    .stat-card span {
        display: block;
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .stat-card strong {
        display: block;
        font-size: 25px;
    }

    .stat-card small {
        display: block;
        color: #9ca3af;
        font-size: 11px;
        margin-top: 3px;
    }



    .section {
        margin-bottom: 35px;
        scroll-margin-top: 25px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 17px;
        gap: 15px;
    }

        .section-header h2 {
            margin: 0;
            font-size: 20px;
        }

        .section-header p {
            margin: 5px 0 0;
            color: #9ca3af;
            font-size: 12px;
        }

    .count-badge {
        padding: 7px 12px;
        background: #eef2ff;
        color: #4338ca;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .count-badge.yellow {
            background: #fef3c7;
            color: #b45309;
        }

        .count-badge.green {
            background: #dcfce7;
            color: #15803d;
        }

        .count-badge.red {
            background: #fee2e2;
            color: #b91c1c;
        }

    .section.highlight {
        animation: highlightPulse 1.1s ease;
        border-radius: 18px;
    }

    @@keyframes highlightPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(79,70,229,.35);
        }

        50% {
            box-shadow: 0 0 0 10px rgba(79,70,229,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(79,70,229,0);
        }
    }


   

    .room-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .room-card {
        background: white;
        border-radius: 17px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        border: 1px solid #eef0f4;
        transition: .2s;
    }

        .room-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 25px rgba(0,0,0,.08);
        }

    .waiting-card {
        border-top: 4px solid #f59e0b;
    }

    .cleaning-card {
        border-top: 4px solid #fbbf24;
    }

    .maintenance-card {
