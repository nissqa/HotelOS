            color: #b45309;
        }

    .progress-bar {
        height: 6px;
        background: #fde68a;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-fill {
        width: 55%;
        height: 100%;
        background: #f59e0b;
        border-radius: 10px;
    }



    .maintenance-message {
        margin-top: 14px;
        padding: 12px;
        background: #fff1f2;
        border-radius: 10px;
    }

        .maintenance-message strong {
            display: block;
            color: #b91c1c;
            font-size: 11px;
        }

        .maintenance-message span {
            display: block;
            margin-top: 4px;
            color: #9f1239;
            font-size: 10px;
        }



    .completed-list {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .completed-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        border-bottom: 1px solid #f1f1f1;
    }

        .completed-item:last-child {
            border-bottom: none;
        }

    .completed-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #dcfce7;
        color: #15803d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .completed-room {
        flex: 1;
    }

        .completed-room strong {
            display: block;
            font-size: 14px;
        }

        .completed-room span {
            display: block;
            color: #9ca3af;
            font-size: 11px;
            margin-top: 3px;
        }

    .completed-date {
        text-align: right;
    }

        .completed-date strong {
            display: block;
            font-size: 12px;
        }

        .completed-date span {
            display: block;
            color: #9ca3af;
            font-size: 10px;
            margin-top: 3px;
        }


    .empty-box {
        background: white;
        border-radius: 16px;
        padding: 50px 20px;
        text-align: center;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

    .small-empty {
        padding: 35px 20px;
    }

    .empty-icon {
        font-size: 38px;
        margin-bottom: 10px;
    }

    .empty-box strong {
        display: block;
        font-size: 15px;
        color: #4b5563;
    }

    .empty-box span {
        display: block;
        color: #9ca3af;
        font-size: 12px;
        margin-top: 5px;
    }



    .priority-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .priority-modal {
        background: white;
        border-radius: 16px;
        padding: 24px;
        width: 320px;
        max-width: calc(100% - 30px);
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,.2);
    }

        .priority-modal h3 {
            margin: 0 0 6px;
        }

        .priority-modal p {
            margin: 0 0 18px;
            color: #6b7280;
            font-size: 13px;
        }

    .priority-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 14px;
    }

    .priority-option {
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        font-size: 13px;
    }

        .priority-option.normal {
            background: #e0e7ff;
            color: #3730a3;
        }

        .priority-option.acil {
            background: #fef3c7;
            color: #b45309;
        }

        .priority-option.cok-acil {
            background: #fee2e2;
            color: #b91c1c;
        }

    .priority-cancel {
        border: none;
        background: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 12px;
    }



    @@media (max-width: 1100px) {

        .stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .room-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px) {

        .cleaning-page {
            padding: 20px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .today-box {
            width: 100%;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .room-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            align-items: flex-start;
        }

        .card-actions {
            flex-direction: column;
        }

        .maintenance-btn {
            width: 100%;
        }

        .completed-item {
            flex-wrap: wrap;
        }

        .completed-date {
            width: 100%;
            text-align: left;
            padding-left: 52px;
        }
    }

</style>


<script>


    function goToSection(sectionId) {

        const el = document.getElementById(sectionId);

        if (!el) {
            return;
        }

        el.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

        el.classList.remove("highlight");

        void el.offsetWidth;

        el.classList.add("highlight");

        setTimeout(function () {

            el.classList.remove("highlight");

        }, 1200);
    }



    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".stat-card").forEach(function (card) {

            card.addEventListener("keydown", function (e) {

                if (e.key === "Enter" || e.key === " ") {

                    e.preventDefault();

                    card.click();
                }

            });

        });

    });



    async function getApiMessage(response) {

        const text = await response.text();

        if (!text) {
            return "İşlem sırasında bir hata oluştu.";
        }

        try {

            const data = JSON.parse(text);

            return data.message ||
                   data.title ||
                   data.error ||
                   "İşlem sırasında bir hata oluştu.";

        }
        catch {

            return text;
        }
    }


    

    async function startCleaning(id) {

        if (!id) {
            alert("Geçersiz temizlik görevi.");
            return;
        }

        const buttons = document.querySelectorAll(
            `[onclick="startCleaning(${id})"]`
        );

        buttons.forEach(function (button) {
            button.disabled = true;
            button.innerText = "⏳ Başlatılıyor...";
        });


        try {

            const response = await fetch(
                `/api/CleaningTasks/${id}/start`,
                {
                    method: "PUT",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );


            if (!response.ok) {

                const message = await getApiMessage(response);

                alert(message);

                buttons.forEach(function (button) {
                    button.disabled = false;
                    button.innerText = "🧹 Temizliğe Başla";
                });

                return;
            }


            window.location.reload();

        }
        catch (error) {

            console.error(error);

            alert("Sunucuya bağlanırken bir hata oluştu.");

            buttons.forEach(function (button) {
                button.disabled = false;
                button.innerText = "🧹 Temizliğe Başla";
            });

        }

    }



    async function completeCleaning(id) {

        if (!id) {
            alert("Geçersiz temizlik görevi.");
            return;
        }

        const buttons = document.querySelectorAll(
            `[onclick="completeCleaning(${id})"]`
        );

        buttons.forEach(function (button) {
            button.disabled = true;
            button.innerText = "⏳ Tamamlanıyor...";
        });


        try {

            const response = await fetch(
                `/api/CleaningTasks/${id}/complete`,
                {
                    method: "PUT",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );


            if (!response.ok) {

                const message = await getApiMessage(response);

                alert(message);

                buttons.forEach(function (button) {
                    button.disabled = false;
                    button.innerText = "✓ Temizliği Bitir";
                });

                return;
            }


            window.location.reload();

        }
        catch (error) {

            console.error(error);

            alert("Sunucuya bağlanırken bir hata oluştu.");

            buttons.forEach(function (button) {
                button.disabled = false;
                button.innerText = "✓ Temizliği Bitir";
            });

        }

    }



    let pendingMaintenanceId = null;


    function sendMaintenance(id) {

        if (!id) {
            alert("Geçersiz temizlik görevi.");
            return;
        }

        pendingMaintenanceId = id;

        const modal = document.getElementById("priorityModal");

        if (modal) {
            modal.style.display = "flex";
        }

    }


    function closePriorityModal() {

        pendingMaintenanceId = null;

        const modal = document.getElementById("priorityModal");

        if (modal) {
            modal.style.display = "none";
        }

    }


    

    async function confirmMaintenance(priority) {

        if (pendingMaintenanceId === null) {
            return;
        }


        const id = pendingMaintenanceId;


        const modal = document.getElementById("priorityModal");

        if (modal) {
            modal.style.display = "none";
        }


        try {

            const response = await fetch(
                `/api/CleaningTasks/${id}/maintenance`,
                {
                    method: "PUT",

                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },

                    body: JSON.stringify({
                        priority: priority
                    })
                }
            );


            if (!response.ok) {

                const message = await getApiMessage(response);

                alert(message);

                pendingMaintenanceId = null;

                if (modal) {
                    modal.style.display = "none";
                }

                return;
            }


            pendingMaintenanceId = null;

            window.location.reload();

        }
        catch (error) {

            console.error(error);

            alert("Sunucuya bağlanırken bir hata oluştu.");

            pendingMaintenanceId = null;

        }

    }



    document.addEventListener("click", function (event) {

        const modal = document.getElementById("priorityModal");

        if (!modal) {
            return;
        }

        if (event.target === modal) {
            closePriorityModal();
        }

    });


    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {

            if (pendingMaintenanceId !== null) {
                closePriorityModal();
            }

        }

    });

</script>