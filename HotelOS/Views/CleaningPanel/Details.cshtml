```cshtml
@model HotelOS.Models.CleaningTask

@{
    ViewData["Title"] = "Temizlik Görevi Detayı";

    var employee = Model.Employee;
    var room = Model.Room;

    var employeeName = employee != null
        ? employee.FirstName + " " + employee.LastName
        : "Atanmamış";

    var roomNumber = room?.RoomNumber ?? "-";

    var statusClass = Model.Status switch
    {
        "Tamamlandı" => "completed",
        "Bekliyor" => "pending",
        "Devam Ediyor" => "progress",
        _ => "unknown"
    };
}

<div class="details-page">

   

    <div class="top-bar">

        <div>
            <h1>🧹 Temizlik Görevi Detayı</h1>

            <p>
                Oda temizliği, personel ve görev bilgilerini görüntüleyin.
            </p>
        </div>

        <a href="/CleaningTasks/Index" class="back-btn">
            ← Temizliğe Dön
        </a>

    </div>



    <div class="stats">

       

        <a href="/CleaningTasks/Index"
           class="stat-card stat-link">

            <div class="stat-icon blue">
                🧹
            </div>

            <div>
                <span>Toplam Görev</span>

                <strong>
                    Tüm Görevler
                </strong>

                <small>
                    Tüm temizlik görevlerini görüntüle →
                </small>
            </div>

        </a>



        <a href="/CleaningTasks/Index#pending"
           class="stat-card stat-link">

            <div class="stat-icon orange">
                ⏳
            </div>

            <div>
                <span>Bekleyen</span>

                <strong>
                    Bekleyen Görevler
                </strong>

                <small>
                    Bekleyen görevleri görüntüle →
                </small>
            </div>

        </a>


       

        <a href="/CleaningTasks/Index#completed"
           class="stat-card stat-link">

            <div class="stat-icon green">
                ✓
            </div>

            <div>
                <span>Tamamlanan</span>

                <strong>
                    Tamamlanan Görevler
                </strong>

                <small>
                    Tamamlanan görevleri görüntüle →
                </small>
            </div>

        </a>


       

        <a href="/CleaningTasks/Index#today"
           class="stat-card stat-link">

            <div class="stat-icon purple">
                📅
            </div>

            <div>
                <span>Bugünkü Görev</span>

                <strong>
                    Bugünkü İşlemler
                </strong>

                <small>
                    Bugünkü görevleri görüntüle →
                </small>
            </div>

        </a>

    </div>



    <div class="details-grid">

       

        <div class="detail-card">

            <div class="card-header">

                <div class="header-icon blue">
                    🧹
                </div>

                <div>
                    <h2>Görev Bilgileri</h2>

                    <span>
                        Temizlik görevinin temel bilgileri
                    </span>
                </div>

            </div>


            <div class="info-list">

                <div class="info-row">

                    <span>Görev No</span>

                    <strong>
                        #@Model.Id
                    </strong>

                </div>


                <div class="info-row">

                    <span>Görev Tarihi</span>

                    <strong>
                        @Model.TaskDate.ToString("dd.MM.yyyy HH:mm")
                    </strong>

                </div>


                <div class="info-row">

                    <span>Durum</span>

                    <strong>
                        <span class="status @statusClass">
                            ● @(Model.Status ?? "Belirsiz")
                        </span>
                    </strong>

                </div>


                <div class="info-row">

                    <span>Not</span>

                    <strong class="notes">

                        @if (string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <span class="muted">
                                Not eklenmemiş
                            </span>
                        }
                        else
                        {
                            @Model.Notes
                        }

                    </strong>

                </div>

            </div>

        </div>



        <div class="detail-card">

            <div class="card-header">

                <div class="header-icon purple">
                    🛏️
                </div>

                <div>
                    <h2>Oda Bilgileri</h2>

                    <span>
                        Temizlenecek oda bilgileri
                    </span>
                </div>

            </div>


            <div class="room-box">

                <div class="room-icon">
                    🛏️
                </div>

                <div>

                    <h3>
                        Oda @roomNumber
                    </h3>

                    <p>
                        Oda ID: @Model.RoomId
                    </p>

                </div>

            </div>


            <div class="info-list">

                <div class="info-row">

                    <span>Oda Numarası</span>

                    <strong>
                        @roomNumber
                    </strong>

                </div>


                <div class="info-row">

                    <span>Oda ID</span>

                    <strong>
                        @Model.RoomId
                    </strong>

                </div>

            </div>

        </div>


        <div class="detail-card">

            <div class="card-header">

                <div class="header-icon green">
                    👨‍💼
                </div>

                <div>
                    <h2>Personel Bilgileri</h2>

                    <span>
                        Görevden sorumlu personel
                    </span>
                </div>

            </div>


            <div class="employee-box">

                <div class="big-avatar">

                    @if (employee != null &&
                                        !string.IsNullOrWhiteSpace(employee.FirstName))
                    {
                        @employee.FirstName.Substring(0, 1)

                        @if (!string.IsNullOrWhiteSpace(employee.LastName))
                        {
                            @employee.LastName.Substring(0, 1)
                        }
                    }
                    else
                    {
                        <span>?</span>
                    }

                </div>


                <div>

                    <h3>
                        @employeeName
                    </h3>

                    <p>
                        🧹 Temizlik Personeli
                    </p>

                </div>

            </div>


            <div class="info-list">

                <div class="info-row">

                    <span>Personel ID</span>

                    <strong>
                        @Model.EmployeeId
                    </strong>

                </div>

            </div>

        </div>


       

        <div class="detail-card summary-card">

            <div class="card-header">

                <div class="header-icon orange">
                    📊
                </div>

                <div>
                    <h2>Görev Özeti</h2>

                    <span>
                        Temizlik görevinin mevcut durumu
                    </span>
                </div>

            </div>


            <div class="summary-icon">
                🧹
            </div>


            <div class="summary-title">
                Oda @roomNumber
            </div>


            <div class="summary-employee">
                @employeeName
            </div>


            <div class="summary-status">

                <span class="status @statusClass">
                    ● @(Model.Status ?? "Belirsiz")
                </span>

            </div>


            <div class="summary-date">

                📅 @Model.TaskDate.ToString("dd.MM.yyyy HH:mm")

            </div>

        </div>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        background: #f5f7fb;
        color: #1f2937;
    }

    .details-page {
        padding: 30px;
        min-height: 100vh;
    }


    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

        .top-bar h1 {
            margin: 0;
            font-size: 30px;
        }

        .top-bar p {
            margin-top: 7px;
            color: #6b7280;
        }

    .back-btn {
        text-decoration: none;
        background: white;
        color: #4338ca;
        border: 1px solid #c7d2fe;
        padding: 11px 16px;
        border-radius: 10px;
        font-weight: 600;
        transition: .2s;
    }

        .back-btn:hover {
            background: #eef2ff;
            transform: translateY(-1px);
        }


    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
    }

    .stat-link {
        text-decoration: none;
        color: #1f2937;
        cursor: pointer;
        transition: .2s;
    }

        .stat-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0,0,0,.11);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #dbeafe;
        }

        .stat-icon.orange {
            background: #ffedd5;
        }

        .stat-icon.green {
            background: #dcfce7;
        }

        .stat-icon.purple {
            background: #ede9fe;
        }

    .stat-card span {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .stat-card strong {
        display: block;
        font-size: 17px;
    }

    .stat-card small {
        display: block;
        margin-top: 6px;
        color: #6b7280;
        font-size: 11px;
    }



    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .detail-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,.06);
    }



    .card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eee;
        margin-bottom: 18px;
    }

        .card-header h2 {
            margin: 0;
            font-size: 18px;
        }

        .card-header span {
            display: block;
            margin-top: 4px;
            color: #9ca3af;
            font-size: 12px;
        }

    .header-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

        .header-icon.blue {
            background: #dbeafe;
        }

        .header-icon.purple {
            background: #ede9fe;
        }

        .header-icon.green {
            background: #dcfce7;
        }

        .header-icon.orange {
            background: #ffedd5;
        }


    .info-list {
        display: flex;
        flex-direction: column;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid #f1f1f1;
    }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row > span {
            color: #6b7280;
            font-size: 13px;
        }

        .info-row strong {
            text-align: right;
            font-size: 14px;
        }

    .notes {
        max-width: 250px;
        word-break: break-word;
    }

    .muted {
        color: #9ca3af;
    }



    .status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status.completed {
            background: #dcfce7;
            color: #15803d;
        }

        .status.pending {
            background: #fef3c7;
            color: #b45309;
        }

        .status.progress {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status.unknown {
            background: #f3f4f6;
            color: #6b7280;
        }


    /* ================= ODA ================= */

    .room-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: #f8fafc;
        border-radius: 12px;
        margin-bottom: 12px;
    }

    .room-icon {
        width: 55px;
        height: 55px;
        border-radius: 13px;
        background: #ede9fe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .room-box h3 {
        margin: 0 0 5px;
        font-size: 19px;
    }

    .room-box p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }


    .employee-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px 0 20px;
    }

    .big-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #dcfce7;
        color: #15803d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 19px;
        flex-shrink: 0;
    }

    .employee-box h3 {
        margin: 0 0 7px;
        font-size: 18px;
    }

    .employee-box p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }


    
    .summary-card {
        text-align: center;
    }

        .summary-card .card-header {
            text-align: left;
        }

    .summary-icon {
        font-size: 42px;
        margin: 8px 0;
    }

    .summary-title {
        font-size: 22px;
        font-weight: bold;
        margin-top: 5px;
    }

    .summary-employee {
        color: #6b7280;
        margin-top: 6px;
        font-size: 14px;
    }

    .summary-status {
        margin-top: 18px;
    }

    .summary-date {
        margin-top: 18px;
        color: #6b7280;
        font-size: 13px;
    }



    @@media (max-width: 1100px) {

        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 800px) {

        .details-page {
            padding: 20px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .top-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 550px) {

        .stats {
            grid-template-columns: 1fr;
        }
    }

</style>

