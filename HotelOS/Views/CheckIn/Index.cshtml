@model HotelOS.Models.ViewModels.CheckInViewModel

@{
    ViewData["Title"] = "Check-in";
}


<style>

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .back-btn {
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        background: #eee;
        color: #333;
    }


    .message {
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .success {
        background: #d1fae5;
        color: #065f46;
    }

    .error {
        background: #fee2e2;
        color: #991b1b;
    }


    .summary {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }


    .summary-card {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: white;
        border-radius: 15px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        transition: .2s;
    }


        .summary-card:hover {
            transform: translateY(-5px);
        }


    .summary-icon {
        font-size: 35px;
    }


    .summary-card span {
        display: block;
        color: #666;
    }


    .summary-card strong {
        font-size: 28px;
    }



    .reservation-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }



    .guest {
        display: flex;
        gap: 15px;
        align-items: center;
    }



    .avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #6366f1;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }



    .guest-name {
        font-size: 18px;
        font-weight: bold;
    }


    .guest-info {
        color: #666;
    }



    .details {
        display: flex;
        gap: 25px;
    }


    .detail-label {
        display: block;
        color: #777;
        font-size: 13px;
    }


    .status {
        background: #fef3c7;
        color: #92400e;
        padding: 5px 10px;
        border-radius: 10px;
    }


    .checkin-btn {
        background: #16a34a;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 10px;
        cursor: pointer;
    }


    .empty {
        text-align: center;
        padding: 50px;
        background: white;
        border-radius: 15px;
    }

</style>



<div class="header">

    <div>

        <h1>🚪 Check-in</h1>

        <p>
            Bugün giriş yapacak müşterilerin işlemlerini yönetin.
        </p>

    </div>


    <a href="/Reception" class="back-btn">
        ← Ana Sayfa
    </a>


</div>



@if (TempData["Success"] != null)
{
    <div class="message success">

        ✓ @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="message error">

        ⚠️ @TempData["Error"]

    </div>
}



<!-- ÜST 3 TIKLANABİLİR KART -->

<div class="summary">


    <a href="/CheckIn/Today" class="summary-card">

        <div class="summary-icon">
            📅
        </div>

        <div>

            <span>
                Bugünkü Girişler
            </span>


            <strong>
                @Model.TodayReservations.Count()
            </strong>

        </div>


    </a>


        <div class="summary-card">


        <div class="summary-icon">
            👥
        </div>


        <div>

            <span>
                Kalan Misafirler
            </span>


            <strong>
                @Model.CompletedCheckIns.Count()
            </strong>

        </div>


        </div>




        <a href="/RoomsView/Occupied" class="summary-card">


        <div class="summary-icon">

            🛏️

        </div>


        <div>


            <span>
                Dolu Odalar
            </span>


            <strong>
                @(Model.TodayReservations
                                .Where(r => r.Status == "CheckedIn")
                                .Select(r => r.RoomId)
                                .Distinct()
                                .Count())
            </strong>


        </div>


    </a>



</div>

<div id="completed-checkins">

    <h2>
        ✅ Bugün Yapılan Check-inler
    </h2>


    @if (!Model.CompletedCheckIns.Any())
    {
        <div class="empty">

            <h3>
                Bugün yapılmış check-in yok
            </h3>

        </div>
    }
    else
    {
        foreach (var reservation in Model.CompletedCheckIns)
        {

            <div class="reservation-card">

                <div class="guest">

                    <div class="avatar">

                        @(reservation.Customer?.FirstName?.Substring(0, 1) ?? "?")

                    </div>


                    <div>

                        <div class="guest-name">

                            @reservation.Customer?.FirstName
                            @reservation.Customer?.LastName

                        </div>


                        <div class="guest-info">

                            🛏️ Oda:
                            @(reservation.Room?.RoomNumber ?? "-")

                        </div>

                    </div>


                </div>


                <span class="status">
                    Check-in Tamamlandı
                </span>


            </div>

        }
    }

</div>



<div class="reservation-list">


    @if (!Model.PendingCheckIns.Any())
    {


        <div class="empty">


            <div style="font-size:50px">
                🎉
            </div>


            <h2>
                Bugün bekleyen check-in yok
            </h2>


            <p>
                Bugün için giriş yapacak müşteri bulunmuyor.
            </p>


        </div>


    }

    else
    {


        @foreach (var reservation in Model.PendingCheckIns)
        {


            var firstName = reservation.Customer?.FirstName ?? "";

            var lastName = reservation.Customer?.LastName ?? "";



            var initials =
            (firstName.Length > 0 ? firstName[0].ToString() : "") +
            (lastName.Length > 0 ? lastName[0].ToString() : "");



            <div class="reservation-card">



                <div class="guest">


                    <div class="avatar">

                        @initials.ToUpper()

                    </div>



                    <div>

                        <div class="guest-name">

                            @firstName @lastName

                        </div>



                        <div class="guest-info">

                            @reservation.AdultCount yetişkin

                            •

                            @reservation.ChildCount çocuk


                        </div>


                    </div>


                </div>




                <div class="details">


                    <div>

                        <span class="detail-label">
                            Oda
                        </span>


                        <span>

                            🛏️ @(reservation.Room?.RoomNumber ?? "-")

                        </span>


                    </div>



                    <div>

                        <span class="detail-label">
                            Giriş
                        </span>


                        <span>

                            @reservation.CheckIn.ToString("dd.MM.yyyy")

                        </span>


                    </div>




                    <div>

                        <span class="detail-label">
                            Çıkış
                        </span>


                        <span>

                            @reservation.CheckOut.ToString("dd.MM.yyyy")

                        </span>


                    </div>



                    <div>

                        <span class="detail-label">
                            Durum
                        </span>


                        <span class="status">

                            Check-in Bekliyor

                        </span>


                    </div>



                </div>





                <form action="/CheckIn/CheckIn"
                      method="post">


                    @Html.AntiForgeryToken()



                    <input type="hidden"
                           name="id"
                           value="@reservation.Id" />



                    <button class="checkin-btn"
                            type="submit">

                        ✓ Check-in Yap

                    </button>


                </form>




            </div>


        }



    }


</div>