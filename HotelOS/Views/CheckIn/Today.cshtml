@model IEnumerable<HotelOS.Models.Reservation>

@{
    ViewData["Title"] = "Bugünkü Girişler";
    var search = ViewData["Search"] as string;
}

<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .back-btn {
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        background: #eee;
        color: #333;
    }

    .search-bar {
        margin-bottom: 25px;
    }

        .search-bar input {
            width: 100%;
            max-width: 400px;
            padding: 12px 16px;
            border-radius: 10px;
            border: 1px solid #ddd;
            font-size: 15px;
        }

    .reservation-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .guest {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #6366f1;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .guest-name {
        font-size: 18px;
        font-weight: bold;
    }

    .guest-info {
        color: #666;
    }

    .status {
        background: #d1fae5;
        color: #065f46;
        padding: 5px 10px;
        border-radius: 10px;
    }

    .empty {
        text-align: center;
        padding: 50px;
        background: white;
        border-radius: 15px;
    }
</style>

<div class="header">
    <div>
        <h1>✅ Bugünkü Girişler</h1>
        <p>Bugün tamamlanan check-in işlemleri.</p>
    </div>

    <a href="/CheckIn/Index" class="back-btn">← Check-in Sayfası</a>
</div>

<div class="search-bar">
    <form method="get" action="/CheckIn/Today">
        <input type="text" name="search" value="@search" placeholder="İsim veya oda numarasına göre ara..." />
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty">
        <h3>Sonuç bulunamadı</h3>
    </div>
}
else
{
    foreach (var reservation in Model)
    {
        <div class="reservation-card">
            <div class="guest">
                <div class="avatar">
                    @(reservation.Customer?.FirstName?.Substring(0, 1) ?? "?")
                </div>
                <div>
                    <div class="guest-name">
                        @reservation.Customer?.FirstName @reservation.Customer?.LastName
                    </div>
                    <div class="guest-info">
                        🛏️ Oda: @(reservation.Room?.RoomNumber ?? "-")
                        •
                        @reservation.AdultCount yetişkin, @reservation.ChildCount çocuk
                        •
                        Çıkış: @reservation.CheckOut.ToString("dd.MM.yyyy")
                    </div>
                </div>
            </div>

            <span class="status">Check-in Tamamlandı</span>
        </div>
    }
}