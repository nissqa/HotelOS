@model HotelOS.Models.Room

@{
    ViewData["Title"] = "Oda Detayı";
}

<div class="details-page">

    <div class="details-card">

        <div class="header">
            <div class="icon">🛏️</div>

            <div>
                <h1>Oda @Model.RoomNumber</h1>
                <p>Oda detayları</p>
            </div>
        </div>

        <div class="info-grid">

            <div class="info-box">
                <span>🏷️ Oda Tipi</span>
                <strong>@Model.RoomType?.TypeName</strong>
            </div>

            <div class="info-box">
                <span>🏢 Kat</span>
                <strong>@Model.Floor. Kat</strong>
            </div>

            <div class="info-box">
                <span>💰 Gecelik Fiyat</span>
                <strong>₺@Model.RoomType?.PricePerNight.ToString("N0")</strong>
            </div>

            <div class="info-box">
                <span>👥 Kapasite</span>
                <strong>@Model.RoomType?.Capacity Kişi</strong>
            </div>

        </div>

        <div class="status-box">
            <span>Durum</span>

            @if (Model.Status.ToString() == "Available")
            {
                <strong class="available">🟢 Müsait</strong>
            }
            else if (Model.Status.ToString() == "Occupied")
            {
                <strong class="occupied">🔴 Dolu</strong>
            }
            else if (Model.Status.ToString() == "Cleaning")
            {
                <strong class="cleaning">🟡 Temizlikte</strong>
            }
            else
            {
                <strong class="maintenance">🔵 Bakımda</strong>
            }
        </div>

        <div class="description">
            <h3>📝 Açıklama</h3>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "Bu oda için açıklama bulunmuyor."
                                : Model.Description)
            </p>
        </div>

        <div class="buttons">

            <a href="/RoomsView" class="back">
                ← Odalara Dön
            </a>

            <a href="/RoomEdit?id=@Model.Id" class="edit">
                ✏ Düzenle
            </a>

        </div>

    </div>

</div>

<style>

    body {
        margin: 0;
        background: #f6f7fb;
        font-family: "Segoe UI", sans-serif;
    }

    .details-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .details-card {
        width: 650px;
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 30px;
    }

    .icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #eeeafd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    h1 {
        margin: 0;
        color: #1f2937;
    }

    .header p {
        margin: 5px 0 0;
        color: #6b7280;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .info-box {
        background: #f8f9fc;
        border-radius: 14px;
        padding: 18px;
    }

        .info-box span {
            display: block;
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .info-box strong {
            color: #1f2937;
            font-size: 17px;
        }

    .status-box {
        margin-top: 20px;
        padding: 18px;
        border-radius: 14px;
        background: #f8f9fc;
    }

        .status-box span {
            display: block;
            color: #6b7280;
            margin-bottom: 7px;
        }

    .available {
        color: #16a34a;
    }

    .occupied {
        color: #dc2626;
    }

    .cleaning {
        color: #ca8a04;
    }

    .maintenance {
        color: #2563eb;
    }

    .description {
        margin-top: 20px;
        padding: 20px;
        background: #f8f9fc;
        border-radius: 14px;
    }

        .description h3 {
            margin-top: 0;
            color: #374151;
        }

        .description p {
            color: #6b7280;
            margin-bottom: 0;
        }

    .buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .back,
    .edit {
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

    .back {
        background: #f3f4f6;
        color: #374151;
    }

    .edit {
        background: #6d5dfc;
        color: white;
    }

</style>