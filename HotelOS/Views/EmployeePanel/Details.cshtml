@model HotelOS.Models.Employee

@{
    ViewData["Title"] = "Personel Detayı";
}

<div class="detail-page">


    <a href="/EmployeePanel" class="back-btn">
        ← Personellere Dön
    </a>




    <div class="profile-card">

        <div class="profile-avatar">
            @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
        </div>

        <div class="profile-info">

            <h1>
                @Model.FirstName @Model.LastName
            </h1>

            <p>
                @(Model.Position ?? "Pozisyon belirtilmemiş")
            </p>

            @if (Model.Status == "Aktif")
            {
                <span class="status active">
                    ● Aktif
                </span>
            }
            else
            {
                <span class="status passive">
                    ● @Model.Status
                </span>
            }

        </div>

    </div>




    <div class="info-grid">


        <div class="info-card">

            <span>📧 E-posta</span>

            <strong>
                @(Model.Email ?? "-")
            </strong>

        </div>


        <div class="info-card">

            <span>📞 Telefon</span>

            <strong>
                @(Model.Phone ?? "-")
            </strong>

        </div>


        <div class="info-card">

            <span>💰 Maaş</span>

            <strong>
                ₺@Model.Salary.ToString("N0")
            </strong>

        </div>


        <div class="info-card">

            <span>📅 İşe Başlama</span>

            <strong>
                @Model.HireDate.ToString("dd.MM.yyyy")
            </strong>

        </div>

    </div>




    <div class="tasks-card">

        <div class="section-header">

            <div>
                <h2>🧹 Görev Geçmişi</h2>

                <p>
                    Bu personelin gerçekleştirdiği temizlik görevleri.
                </p>
            </div>

        </div>


        @if (Model.CleaningTasks != null && Model.CleaningTasks.Any())
        {

            <div class="task-list">

                @foreach (var task in Model.CleaningTasks.OrderByDescending(t => t.TaskDate))
                {

                    <div class="task-item">

                        <div class="task-icon">
                            🛏️
                        </div>


                        <div class="task-info">

                            <strong>
                                Oda @(task.Room?.RoomNumber ?? "-")
                            </strong>

                            <span>
                                📅 @task.TaskDate.ToString("dd.MM.yyyy HH:mm")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(task.Notes))
                            {
                                <small>
                                    📝 @task.Notes
                                </small>
                            }

                        </div>


                        <div>

                            @if (task.Status == "Tamamlandı")
                            {
                                <span class="task-status completed">
                                    ✓ Tamamlandı
                                </span>
                            }
                            else
                            {
                                <span class="task-status">
                                    @task.Status
                                </span>
                            }

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty">

                🧹

                <strong>
                    Henüz görev kaydı yok
                </strong>

               

            </div>

        }

    </div>
    ```

</div>

<style>

    * {
        box-sizing: border-box;
    }

    .detail-page {
        padding: 30px;
        color: #1f2937;
    }


  

    .back-btn {
        display: inline-block;
        margin-bottom: 20px;
        text-decoration: none;
        color: #4f46e5;
        font-weight: 600;
    }


    

    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }


    .profile-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4338ca;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
    }


    .profile-info h1 {
        margin: 0 0 5px;
        font-size: 26px;
    }

    .profile-info p {
        margin: 0 0 10px;
        color: #6b7280;
    }


   
    .status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .status.active {
            background: #dcfce7;
            color: #15803d;
        }

        .status.passive {
            background: #f3f4f6;
            color: #6b7280;
        }


 
    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.05);
    }

        .info-card span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .info-card strong {
            font-size: 15px;
        }


  

    .tasks-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .section-header {
        padding: 22px;
        border-bottom: 1px solid #eee;
    }

        .section-header h2 {
            margin: 0;
        }

        .section-header p {
            margin-top: 5px;
            color: #6b7280;
            font-size: 13px;
        }



    .task-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 17px 22px;
        border-bottom: 1px solid #f1f1f1;
    }

    .task-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .task-info {
        flex: 1;
    }

        .task-info strong {
            display: block;
            margin-bottom: 4px;
        }

        .task-info span {
            display: block;
            color: #6b7280;
            font-size: 13px;
        }

        .task-info small {
            display: block;
            color: #9ca3af;
            margin-top: 4px;
        }




    .task-status {
        background: #f3f4f6;
        color: #6b7280;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

        .task-status.completed {
            background: #dcfce7;
            color: #15803d;
        }




    .empty {
        padding: 45px;
        text-align: center;
        color: #9ca3af;
    }

        .empty strong {
            display: block;
            color: #6b7280;
            margin-top: 10px;
        }

        .empty span {
            display: block;
            margin-top: 5px;
            font-size: 13px;
        }


   

    @@media (max-width: 1000px) {

        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 600px) {

        .info-grid {
            grid-template-columns: 1fr;
        }

        .profile-card {
            flex-direction: column;
            text-align: center;
        }

        .task-item {
            align-items: flex-start;
        }
    }

</style>
