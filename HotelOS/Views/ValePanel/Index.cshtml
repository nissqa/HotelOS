@model List<HotelOS.Models.Vehicle>

@{
    ViewData["Title"] = "Vale & Otopark";

    var todayCustomers =
        ViewBag.TodayCustomers as List<HotelOS.Models.Customer>
        ?? new List<HotelOS.Models.Customer>();
}

<link rel="stylesheet" href="~/css/vale-panel.css" />

<div class="vale-page">


    <div class="vale-header">
        <h1>🚗 Vale & Otopark</h1>

        <p>
            Otelde bulunan araçları ve vale operasyonlarını takip edin.
        </p>
    </div>



    <div class="stats-grid">

        <button type="button"
                class="stat-card"
                onclick="showParking()">

            <div class="stat-icon">🚘</div>

            <div class="stat-content">
                <span>Otoparktaki Araçlar</span>

                <strong>
                    @Model.Count(x => x.Status == "Otoparkta")
                </strong>
            </div>

        </button>


        <button type="button"
                class="stat-card"
                onclick="showWaiting()">

            <div class="stat-icon">🔑</div>

            <div class="stat-content">
                <span>Teslim Bekleyen</span>

                <strong>
                    @Model.Count(x => x.Status == "Teslim Bekliyor")
                </strong>
            </div>

        </button>


        <button type="button"
                class="stat-card"
                onclick="showCleaning()">

            <div class="stat-icon">🧹</div>

            <div class="stat-content">
                <span>Temizlik Bekleyen</span>

                <strong>
                    @Model.Count(x => x.CleaningRequested)
                </strong>
            </div>

        </button>


        <button type="button"
                class="stat-card"
                onclick="showAllVehicles()">

            <div class="stat-icon">📊</div>

            <div class="stat-content">
                <span>Toplam Araç</span>

                <strong>
                    @Model.Count
                </strong>
            </div>

        </button>

    </div>



    <div class="add-vehicle-area">

        <button type="button"
                class="add-vehicle-btn"
                onclick="openVehicleModal()">

            <span>＋</span>
            Yeni Araç Ekle

        </button>

    </div>



    <div class="vehicle-section">

        <div class="section-header">

            <h2>🚗 Araç Takibi</h2>

            <p>
                Otelde bulunan araçları görüntüleyin ve takip edin.
            </p>

        </div>



        <div class="filters">

            <div class="search-box">

                <span class="search-icon">⌕</span>

                <input type="text"
                       id="vehicleSearch"
                       placeholder="İsim, plaka veya telefon ara..."
                       autocomplete="off" />

            </div>


            <select id="statusFilter">

                <option value="all">Tüm Durumlar</option>

                <option value="Otoparkta">
                    Otoparkta
                </option>

                <option value="Teslim Bekliyor">
                    Teslim Bekliyor
                </option>

                <option value="Teslim Edildi">
                    Teslim Edildi
                </option>

            </select>

        </div>



        <div class="vehicle-list">

            @foreach (var vehicle in Model)
            {
                string statusClass = vehicle.Status switch
                {
                    "Otoparkta" => "status-parking",
                    "Teslim Bekliyor" => "status-waiting",
                    "Teslim Edildi" => "status-delivered",
                    _ => "status-default"
                };

                var arrivalDateText =
                vehicle.ArrivalDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm");

                var departureDateText =
                vehicle.DepartureDate.HasValue
                ? vehicle.DepartureDate.Value.ToLocalTime().ToString("dd.MM.yyyy")
                : "-";

                <div class="vehicle-card"
                     data-id="@vehicle.Id"
                     data-status="@vehicle.Status"
                     data-cleaning="@vehicle.CleaningRequested"
                     data-search="@vehicle.CustomerName @vehicle.PlateNumber @vehicle.CustomerPhone">

                   

                    <div class="vehicle-top">

                        <div class="vehicle-info">

                            <div class="car-icon">
                                🚘
                            </div>

                            <div>

                                <h3>
                                    @vehicle.PlateNumber
                                </h3>

                                <p>
                                    @(vehicle.Brand ?? "")
                                    @(string.IsNullOrWhiteSpace(vehicle.Model)
                                                                    ? ""
                                                                    : " " + vehicle.Model)
                            </p>

                            </div>

                        </div>


                        <span class="status @statusClass">
                            ● @vehicle.Status
                        </span>

                    </div>



                    <div class="vehicle-details">

                        <div>
                            <span>Misafir</span>
                            <strong>@vehicle.CustomerName</strong>
                        </div>


                        <div>
                            <span>Telefon</span>
                            <strong>
                                @(vehicle.CustomerPhone ?? "-")
                            </strong>
                        </div>


                        <div>
                            <span>Otopark</span>
                            <strong>
                                Kat @vehicle.ParkingFloor
                            </strong>
                        </div>


                        <div>
                            <span>Konum</span>
                            <strong>
                                @(vehicle.ParkingLocation ?? "-")
                            </strong>
                        </div>


                        <div>
                            <span>Geliş Tarihi</span>
                            <strong>
                                @arrivalDateText
                            </strong>
                        </div>


                        <div>
                            <span>Çıkış / Teslim Tarihi</span>
                            <strong>
                                @departureDateText
                            </strong>
                        </div>

                    </div>


             
                @if (vehicle.CleaningRequested)
                    {
                        <div class="cleaning-warning">
                            🧹 Temizlik talebi bulunuyor
                        </div>
                    }



                    <div class="card-actions">

                        <button type="button"
                                class="card-btn detail-btn"
                                onclick="openDetailsModal(this)"
                                data-id="@vehicle.Id"
                                data-plate="@vehicle.PlateNumber"
                                data-customer="@vehicle.CustomerName"
                                data-phone="@(vehicle.CustomerPhone ?? "-")"
                                data-brand="@(vehicle.Brand ?? "-")"
                                data-model="@(vehicle.Model ?? "-")"
                                data-color="@(vehicle.Color ?? "-")"
                                data-floor="@vehicle.ParkingFloor"
                                data-location="@(vehicle.ParkingLocation ?? "-")"
                                data-status="@vehicle.Status"
                                data-notes="@(vehicle.Notes ?? "-")"
                                data-departure="@departureDateText"
                                data-cleaning="@vehicle.CleaningRequested">

                            Detay

                        </button>


                        <button type="button"
                                class="card-btn edit-btn"
                                onclick="openEditModal(this)"
                                data-id="@vehicle.Id"
                                data-customer="@vehicle.CustomerName"
                                data-phone="@(vehicle.CustomerPhone ?? "")"
                                data-plate="@vehicle.PlateNumber"
                                data-brand="@(vehicle.Brand ?? "")"
                                data-model="@(vehicle.Model ?? "")"
                                data-color="@(vehicle.Color ?? "")"
                                data-floor="@vehicle.ParkingFloor"
                                data-location="@(vehicle.ParkingLocation ?? "")"
                                data-notes="@(vehicle.Notes ?? "")"
                                data-departure="@(vehicle.DepartureDate.HasValue? vehicle.DepartureDate.Value.ToString("yyyy-MM-dd") : "")"
                                data-delivered="@vehicle.IsManuallyDelivered.ToString().ToLower()"
                                data-cleaning="@vehicle.CleaningRequested.ToString().ToLower()">

                            Düzenle

                        </button>

                    </div>

                </div>
            }

        </div>


        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🚗
                </div>

                <h3>
                    Henüz araç bulunmuyor
                </h3>

                <p>
                    Yeni araç eklemek için yukarıdaki butonu kullanabilirsiniz.
                </p>

            </div>
        }

    </div>

</div>



<div id="vehicleModal"
     class="modal-overlay">

    <div class="vehicle-modal">

        <div class="modal-header">

            <div>

                <h2>
                    Yeni Araç Ekle
                </h2>

                <p>
                    Otel müşterisinin veya anlık gelen misafirin araç bilgilerini girin.
                </p>

            </div>


            <button type="button"
                    class="modal-close"
                    onclick="closeVehicleModal()">

                ×

            </button>

        </div>


        <form method="post"
              action="/ValePanel/AddVehicle"
              id="vehicleForm"
              onsubmit="return validateVehicleForm();">

            <div class="form-grid">

              

                <div class="form-group form-full">

                    <label>
                        Otel Müşterisi
                    </label>

                    @if (todayCustomers.Any())
                    {
                        <select id="customerSelect"
                                onchange="selectCustomer(this)">

                            <option value="">
                                Müşteri seçmek istemiyorum / Anlık müşteri
                            </option>

                            @foreach (var customer in todayCustomers)
                            {
                                var fullName =
                                $"{customer.FirstName} {customer.LastName}".Trim();

                                <option value="@customer.Id"
                                        data-name="@fullName"
                                        data-phone="@(customer.Phone ?? "")">

                                    @fullName

                                    @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                    {
                                        <text> - @customer.Phone</text>
                                    }

                                </option>
                            }

                        </select>
                    }
                    else
                    {
                        <div style="padding:12px;">
                            Bugün rezervasyonu olan müşteri bulunmuyor.
                            Aşağıdaki alanlardan anlık müşterinin bilgileri girilebilir.
                        </div>
                    }

                </div>


          

                <div class="form-group">

                    <label>
                        Müşteri Adı Soyadı *
                    </label>

                    <input type="text"
                           id="customerName"
                           name="CustomerName"
                           placeholder="Örn: Melisa Yılmaz"
                           autocomplete="off"
                           required />

                    <small id="customerNameError"
                           style="display:none;">

                        Ad ve soyad birlikte girilmelidir.

                    </small>

                </div>


          

                <div class="form-group">

                    <label>
                        Telefon
                    </label>

                    <input type="text"
                           id="customerPhone"
                           name="CustomerPhone"
                           placeholder="05XX XXX XX XX"
                           autocomplete="off" />

                </div>


           

                <div class="form-group">

                    <label>
                        Plaka *
                    </label>

                    <input type="text"
                           id="plateNumber"
                           name="PlateNumber"
                           placeholder="34 ABC 123"
                           maxlength="10"
                           autocomplete="off"
                           required />

                    <small id="plateError"
                           style="display:none;">

                        Plaka 34 ABC 123 şeklinde ve boşluklu girilmelidir.

                    </small>

                </div>



                <div class="form-group">

                    <label>Marka</label>

                    <input type="text"
                           name="Brand"
                           placeholder="BMW" />

                </div>


            

                <div class="form-group">

                    <label>Model</label>

                    <input type="text"
                           name="Model"
                           placeholder="320i" />

                </div>


             

                <div class="form-group">

                    <label>Renk</label>

                    <input type="text"
                           name="Color"
                           placeholder="Siyah" />

                </div>


              

                <div class="form-group">

                    <label>
                        Otopark Katı *
                    </label>

                    <input type="number"
                           name="ParkingFloor"
                           min="1"
                           max="3"
                           placeholder="1"
                           required />

                </div>


          

                <div class="form-group">

                    <label>
                        Otopark Konumu
                    </label>

                    <input type="text"
                           name="ParkingLocation"
                           placeholder="B-24" />

                </div>


          

                <div class="form-group">

                    <label>
                        Çıkış Tarihi
                    </label>

                    <input type="date"
                           name="DepartureDate" />

                </div>


             

                <div class="form-group form-full">

                    <div class="cleaning-option">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   id="cleaningRequested"
                                   name="CleaningRequested"
                                   value="true" />

                            <span>

                                🧹 Temizlik talebi oluştur

                                <small>
                                    Araç için temizlik gerekiyorsa işaretleyin.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>


         

                <div class="form-group form-full">

                    <label>
                        Not
                    </label>

                    <textarea name="Notes"
                              placeholder="Araç hakkında not..."></textarea>

                </div>

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="btn-secondary"
                        onclick="closeVehicleModal()">

                    Vazgeç

                </button>


                <button type="submit"
                        class="btn-primary">

                    Aracı Kaydet

                </button>

            </div>

        </form>

    </div>

</div>




<div id="detailsModal"
     class="modal-overlay">

    <div class="vehicle-modal">

        <div class="modal-header">

            <div>

                <h2>🚗 Araç Detayı</h2>

                <p>
                    Araç bilgileri
                </p>

            </div>


            <button type="button"
                    class="modal-close"
                    onclick="closeDetailsModal()">

                ×

            </button>

        </div>


        <div style="padding:23px;">

            <div class="vehicle-details">

                <div>
                    <span>Plaka</span>
                    <strong id="detailPlate"></strong>
                </div>

                <div>
                    <span>Müşteri</span>
                    <strong id="detailCustomer"></strong>
                </div>

                <div>
                    <span>Telefon</span>
                    <strong id="detailPhone"></strong>
                </div>

                <div>
                    <span>Marka</span>
                    <strong id="detailBrand"></strong>
                </div>

                <div>
                    <span>Model</span>
                    <strong id="detailModel"></strong>
                </div>

                <div>
                    <span>Renk</span>
                    <strong id="detailColor"></strong>
                </div>

                <div>
                    <span>Otopark Katı</span>
                    <strong id="detailFloor"></strong>
                </div>

                <div>
                    <span>Otopark Konumu</span>
                    <strong id="detailLocation"></strong>
                </div>

                <div>
                    <span>Durum</span>
                    <strong id="detailStatus"></strong>
                </div>

                <div>
                    <span>Çıkış / Teslim Tarihi</span>
                    <strong id="detailDeparture"></strong>
                </div>

                <div>
                    <span>Temizlik</span>
                    <strong id="detailCleaning"></strong>
                </div>

                <div>
                    <span>Not</span>
                    <strong id="detailNotes"></strong>
                </div>

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="btn-secondary"
                        onclick="closeDetailsModal()">

                    Kapat

                </button>

            </div>

        </div>

    </div>

</div>




<div id="editModal"
     class="modal-overlay">

    <div class="vehicle-modal">

        <div class="modal-header">

            <div>

                <h2>✏️ Araç Düzenle</h2>

                <p>
                    Araç bilgilerini güncelleyin.
                </p>

            </div>


            <button type="button"
                    class="modal-close"
                    onclick="closeEditModal()">

                ×

            </button>

        </div>


        <form method="post"
              action="/ValePanel/Edit">

            <input type="hidden"
                   id="editId"
                   name="Id" />


            <div class="form-grid">

              

                <div class="form-group">

                    <label>
                        Müşteri Adı Soyadı *
                    </label>

                    <input type="text"
                           id="editCustomerName"
                           name="CustomerName"
                           required />

                </div>


               

                <div class="form-group">

                    <label>
                        Telefon
                    </label>

                    <input type="text"
                           id="editCustomerPhone"
                           name="CustomerPhone" />

                </div>


           

                <div class="form-group">

                    <label>
                        Plaka *
                    </label>

                    <input type="text"
                           id="editPlateNumber"
                           name="PlateNumber"
                           maxlength="10"
                           required />

                    <small id="editPlateError"
                           style="display:none;">

                        Plaka 34 ABC 123 şeklinde ve boşluklu girilmelidir.

                    </small>

                </div>


               

                <div class="form-group">

                    <label>Marka</label>

                    <input type="text"
                           id="editBrand"
                           name="Brand" />

                </div>



                <div class="form-group">

                    <label>Model</label>

                    <input type="text"
                           id="editModel"
                           name="Model" />

                </div>



                <div class="form-group">

                    <label>Renk</label>

                    <input type="text"
                           id="editColor"
                           name="Color" />

                </div>


             

                <div class="form-group">

                    <label>
                        Otopark Katı *
                    </label>

                    <input type="number"
                           id="editParkingFloor"
                           name="ParkingFloor"
                           min="1"
                           max="3"
                           required />

                </div>


                

                <div class="form-group">

                    <label>
                        Otopark Konumu
                    </label>

                    <input type="text"
                           id="editParkingLocation"
                           name="ParkingLocation" />

                </div>


              

                <div class="form-group">

                    <label>
                        Çıkış Tarihi
                    </label>

                    <input type="date"
                           id="editDepartureDate"
                           name="DepartureDate" />

                </div>


            

                <div class="form-group form-full">

                    <div class="cleaning-option">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   id="editIsManuallyDelivered"
                                   name="IsManuallyDelivered"
                                   value="true" />

                            <span>

                                Teslim Edildi olarak işaretle

                                <small>
                                    Araç çıkış gününü beklemeden teslim edildiyse işaretleyin.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>



                <div class="form-group form-full">

                    <div class="cleaning-option">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   id="editCleaningRequested"
                                   name="CleaningRequested"
                                   value="true" />

                            <span>

                                🧹 Temizlik talebi oluştur

                                <small>
                                    Araç için temizlik gerekiyorsa işaretleyin.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>


        

                <div class="form-group form-full">

                    <label>
                        Not
                    </label>

                    <textarea id="editNotes"
                              name="Notes"
                              placeholder="Araç hakkında not..."></textarea>

                </div>

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="btn-secondary"
                        onclick="closeEditModal()">

                    Vazgeç

                </button>


                <button type="submit"
                        class="btn-primary">

                    Değişiklikleri Kaydet

                </button>

            </div>

        </form>

    </div>

</div>



<script>


    function selectCustomer(select) {

        const option =
            select.options[select.selectedIndex];

        document.getElementById("customerName").value =
            option.getAttribute("data-name") || "";

        document.getElementById("customerPhone").value =
            option.getAttribute("data-phone") || "";
    }


    function validateVehicleForm() {

        const nameInput =
            document.getElementById("customerName");

        const plateInput =
            document.getElementById("plateNumber");

        const nameError =
            document.getElementById("customerNameError");

        const plateError =
            document.getElementById("plateError");


        const fullName =
            nameInput.value.trim();

        const nameParts =
            fullName
                .split(/\s+/)
                .filter(x => x.length > 0);


        if (nameParts.length < 2) {

            nameError.style.display = "block";
            nameInput.focus();

            return false;
        }

        nameError.style.display = "none";


        const plate =
            plateInput.value
                .trim()
                .toUpperCase();


        const platePattern =
            /^\d{2}\s[A-ZÇĞİÖŞÜ]{1,3}\s\d{2,4}$/;


        if (!platePattern.test(plate)) {

            plateError.style.display = "block";
            plateInput.focus();

            return false;
        }


        plateError.style.display = "none";

        plateInput.value = plate;

        return true;
    }



    const plateInput =
        document.getElementById("plateNumber");

    if (plateInput) {

        plateInput.addEventListener(
            "input",
            function () {

                this.value =
                    this.value.toUpperCase();

            }
        );

    }



    const searchInput =
        document.getElementById("vehicleSearch");

    const statusFilter =
        document.getElementById("statusFilter");

    const vehicleCards =
        document.querySelectorAll(".vehicle-card");



    function filterVehicles() {

        const searchText =
            searchInput.value
                .toLowerCase()
                .trim();

        const selectedStatus =
            statusFilter.value;


        vehicleCards.forEach(function (card) {

            const searchData =
                (card.dataset.search || "")
                    .toLowerCase();

            const cardStatus =
                card.dataset.status;


            const matchesSearch =
                searchData.includes(searchText);

            const matchesStatus =
                selectedStatus === "all" ||
                cardStatus === selectedStatus;


            card.style.display =
                matchesSearch && matchesStatus
                    ? ""
                    : "none";

        });

    }


    searchInput.addEventListener(
        "input",
        filterVehicles
    );


    statusFilter.addEventListener(
        "change",
        filterVehicles
    );


    function showParking() {

        searchInput.value = "";
        statusFilter.value = "Otoparkta";

        filterVehicles();
    }


    function showWaiting() {

        searchInput.value = "";
        statusFilter.value = "Teslim Bekliyor";

        filterVehicles();
    }


    function showCleaning() {

        searchInput.value = "";
        statusFilter.value = "all";


        vehicleCards.forEach(function (card) {

            const cleaning =
                (card.dataset.cleaning || "")
                    .toLowerCase();


            card.style.display =
                cleaning === "true"
                    ? ""
                    : "none";

        });

    }


    function showAllVehicles() {

        searchInput.value = "";
        statusFilter.value = "all";

        vehicleCards.forEach(function (card) {

            card.style.display = "";

        });

    }



    function openVehicleModal() {

        const modal =
            document.getElementById("vehicleModal");

        modal.classList.add("active");

        document.body.classList.add("modal-open");
    }


    function closeVehicleModal() {

        const modal =
            document.getElementById("vehicleModal");

        modal.classList.remove("active");

        document.body.classList.remove("modal-open");
    }



    function openDetailsModal(button) {

        const data = button.dataset;


        document.getElementById("detailPlate").textContent =
            data.plate || "-";

        document.getElementById("detailCustomer").textContent =
            data.customer || "-";

        document.getElementById("detailPhone").textContent =
            data.phone || "-";

        document.getElementById("detailBrand").textContent =
            data.brand || "-";

        document.getElementById("detailModel").textContent =
            data.model || "-";

        document.getElementById("detailColor").textContent =
            data.color || "-";

        document.getElementById("detailFloor").textContent =
            "Kat " + (data.floor || "-");

        document.getElementById("detailLocation").textContent =
            data.location || "-";

        document.getElementById("detailStatus").textContent =
            data.status || "-";

        document.getElementById("detailDeparture").textContent =
            data.departure || "-";

        document.getElementById("detailCleaning").textContent =
            data.cleaning === "True" ||
            data.cleaning === "true"
                ? "Temizlik talebi var"
                : "Temizlik talebi yok";

        document.getElementById("detailNotes").textContent =
            data.notes || "-";


        document
            .getElementById("detailsModal")
            .classList.add("active");

        document.body.classList.add("modal-open");
    }


    function closeDetailsModal() {

        document
            .getElementById("detailsModal")
            .classList.remove("active");

        document.body.classList.remove("modal-open");
    }



    function openEditModal(button) {

        const data = button.dataset;


        document.getElementById("editId").value =
            data.id || "";

        document.getElementById("editCustomerName").value =
            data.customer || "";

        document.getElementById("editCustomerPhone").value =
            data.phone || "";

        document.getElementById("editPlateNumber").value =
            data.plate || "";

        document.getElementById("editBrand").value =
            data.brand || "";

        document.getElementById("editModel").value =
            data.model || "";

        document.getElementById("editColor").value =
            data.color || "";

        document.getElementById("editParkingFloor").value =
            data.floor || "";

        document.getElementById("editParkingLocation").value =
            data.location || "";

        document.getElementById("editNotes").value =
            data.notes || "";

        document.getElementById("editDepartureDate").value =
            data.departure || "";


        const deliveryCheckbox =
            document.getElementById("editIsManuallyDelivered");

        deliveryCheckbox.checked =
            data.delivered === "true";


        const cleaningCheckbox =
            document.getElementById("editCleaningRequested");

        cleaningCheckbox.checked =
            data.cleaning === "true";


        document
            .getElementById("editModal")
            .classList.add("active");

        document.body.classList.add("modal-open");
    }


    function closeEditModal() {

        document
            .getElementById("editModal")
            .classList.remove("active");

        document.body.classList.remove("modal-open");
    }


    
    const editPlate =
        document.getElementById("editPlateNumber");


    if (editPlate) {

        editPlate.addEventListener(
            "input",
            function () {

                this.value =
                    this.value.toUpperCase();

            }
        );

    }



    document.addEventListener(
        "click",
        function (event) {

            if (
                event.target.classList.contains(
                    "modal-overlay"
                )
            ) {

                event.target.classList.remove("active");

                document.body.classList.remove(
                    "modal-open"
                );

            }

        }
    );



    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeVehicleModal();
                closeDetailsModal();
                closeEditModal();

            }

        }
    );

</script>