@model List<HotelOS.Models.CleaningTask>

@{
    ViewData["Title"] = "Temizlik Yönetimi";
    var allTasks = Model ?? new List<HotelOS.Models.CleaningTask>();
}

<div class="cleaning-page">

    <div class="page-header">
        <div>
            <div class="welcome-badge">🧹 ADMIN - TEMİZLİK YÖNETİMİ</div>
            <h1>Temizlik Görevleri</h1>
            <p>Tüm temizlik görevlerini görüntüleyin, yeni görev atayın veya silin.</p>
        </div>

        <a href="/CleaningTaskCreate/Index" class="new-task-btn">
            + Yeni Görev Ata
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="message success">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="message error">⚠ @TempData["Error"]</div>
    }

    <section class="section">
        @if (allTasks.Any())
        {
            <div class="room-grid">
                @foreach (var task in allTasks.OrderByDescending(t => t.TaskDate))
                {
                    var roomNumber = task.Room?.RoomNumber ?? "-";
                    var employeeName = task.Employee != null
                    ? $"{task.Employee.FirstName} {task.Employee.LastName}"
                    : "Atanmamış";

                    var statusClass = task.Status switch
                    {
                        "Bekliyor" => "waiting",
                        "Temizlikte" => "cleaning",
                        "Temizlendi" => "completed",
                        "Bakım" => "maintenance",
                        _ => "waiting"
                    };

                    <div class="room-card @(statusClass)-card">
                        <div class="room-top">
                            <div class="room-icon">🛏️</div>
                            <span class="status-badge @statusClass">@task.Status</span>
                        </div>

                        <div class="room-number">Oda @roomNumber</div>
                        <div class="floor-info">👤 @employeeName</div>

                        <div class="task-info">
                            <span>Görev tarihi</span>
                            <strong>@task.TaskDate.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(task.Notes))
                        {
                            <div class="notes">💬 @task.Notes</div>
                        }

                        <div class="card-actions">
                            <form method="post" action="/CleaningManagement/DeleteTask" onsubmit="return confirm('Bu görevi silmek istediğinize emin misiniz?');" style="width:100%;">
                                <input type="hidden" name="id" value="@task.Id" />
                                <button type="submit" class="action-btn delete-btn">🗑 Sil</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-box">
                <div class="empty-icon">📋</div>
                <strong>Henüz temizlik görevi yok</strong>
                <span>"Yeni Görev Ata" ile ilk görevi oluşturabilirsiniz.</span>
            </div>
        }
    </section>
</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f7fb;
        color: #1f2937;
    }

    .cleaning-page {
        padding: 30px;
        min-height: 100vh;
    }


    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .welcome-badge {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        background: #ede9fe;
        color: #6d28d9;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 750;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .new-task-btn {
        background: #4f46e5;
        color: white;
        text-decoration: none;
        padding: 14px 22px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
        transition: .2s;
        box-shadow: 0 4px 14px rgba(79,70,229,.25);
    }

        .new-task-btn:hover {
            background: #4338ca;
            transform: translateY(-2px);
        }


    .message {
        padding: 13px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        font-weight: 600;
    }

        .message.success {
            background: #dcfce7;
            color: #166534;
        }

        .message.error {
            background: #fee2e2;
            color: #991b1b;
        }


    .section {
        margin-bottom: 35px;
    }


    .room-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .room-card {
        background: white;
        border-radius: 17px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        border: 1px solid #eef0f4;
        transition: .2s;
    }

        .room-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 25px rgba(0,0,0,.08);
        }

    .waiting-card {
        border-top: 4px solid #f59e0b;
    }

    .cleaning-card {
        border-top: 4px solid #fbbf24;
    }

    .completed-card {
        border-top: 4px solid #22c55e;
    }

    .maintenance-card {
        border-top: 4px solid #ef4444;
    }


    .room-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .room-icon {
        width: 47px;
        height: 47px;
        border-radius: 13px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }


    .status-badge {
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status-badge.waiting {
            background: #fef3c7;
            color: #b45309;
        }

        .status-badge.cleaning {
            background: #fef3c7;
            color: #b45309;
        }

        .status-badge.completed {
            background: #dcfce7;
            color: #15803d;
        }

        .status-badge.maintenance {
            background: #fee2e2;
            color: #b91c1c;
        }


    .room-number {
        font-size: 25px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .floor-info {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 17px;
    }

    .task-info {
        padding: 12px;
        border-radius: 10px;
        background: #f8fafc;
        margin-bottom: 12px;
    }

        .task-info span {
            display: block;
            color: #9ca3af;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .task-info strong {
            font-size: 12px;
        }


    .notes {
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: #6b7280;
        font-size: 11px;
        margin-bottom: 13px;
    }


    .card-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .action-btn {
        border: none;
        border-radius: 10px;
        padding: 11px 12px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
        width: 100%;
    }

    .delete-btn {
        background: #fee2e2;
        color: #b91c1c;
    }

        .delete-btn:hover {
            background: #fecaca;
            transform: translateY(-1px);
        }


    .empty-box {
        background: white;
        border-radius: 16px;
        padding: 50px 20px;
        text-align: center;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

    .empty-icon {
        font-size: 38px;
        margin-bottom: 10px;
    }

    .empty-box strong {
        display: block;
        font-size: 15px;
        color: #4b5563;
    }

    .empty-box span {
        display: block;
        color: #9ca3af;
        font-size: 12px;
        margin-top: 5px;
    }


    @@media (max-width: 1100px) {

        .room-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px) {

        .cleaning-page {
            padding: 20px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .new-task-btn {
            width: 100%;
            text-align: center;
        }

        .room-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
